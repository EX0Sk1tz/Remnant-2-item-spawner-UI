<Application x:Class="Remnant2UnlockerApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Remnant2UnlockerApp.Controls"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The active theme. ThemeManager replaces this entry (matched by "Themes/" in its
                 Source) at runtime; views only use DynamicResource for theme keys. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Remnant2UnlockerApp;component/Themes/Classic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Film grain; ThemeManager sets the texture for Remnant and Transparent otherwise. -->
            <SolidColorBrush x:Key="Grain" Color="Transparent"/>

            <!-- Theme-independent converters -->
            <controls:BoolToVisibilityConverter x:Key="BoolVis"/>
            <controls:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
            <controls:BoolToOpacityConverter x:Key="BoolDim"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
