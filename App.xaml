<Application x:Class="Remnant2UnlockerApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Remnant2UnlockerApp.Controls"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Remnant2UnlockerApp;component/Themes/Remnant.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Film grain; ThemeManager.Initialize replaces this with the texture at startup. -->
            <SolidColorBrush x:Key="Grain" Color="Transparent"/>

            <!-- Converters -->
            <controls:BoolToVisibilityConverter x:Key="BoolVis"/>
            <controls:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
            <controls:BoolToOpacityConverter x:Key="BoolDim"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
