<!--
  ═══ Theme: Classic ═══════════════════════════════════════════════════════════
  The original look of the app, extracted unchanged from the windows.

  THEME CONTRACT: every theme (Themes/*.xaml) defines exactly the same x:Key set, and
  the views reference those keys only through DynamicResource. ThemeManager swaps the
  whole dictionary at runtime; "Grain" is set by ThemeManager, not by the theme.

  Values
    True · UiFont · MonoFont · Tracked · TrackedTextTemplate
    Colors      Soot Char Ash AshHi Hairline Bronze Bone BoneDim BoneFaint Ember EmberHi Pending
    Palette     SootBrush CharBrush AshBrush AshHiBrush HairlineBrush BronzeBrush TextBrush
                TextDimBrush TextFaintBrush EmberBrush EmberHiBrush PendingBrush GoodBrush
                WarnBrush BadBrush
    Roles       WindowBackgroundBrush StatusTextBrush HintTextBrush AccentTextBrush
                HighlightTextBrush CodeTextBrush ToastMessageBrush ToastInfoBrush
                ToastSuccessBrush ToastWarningBrush ToastErrorBrush SubtleDividerBrush
                ErrorSurfaceBrush ErrorTextBrush InfoSurfaceBrush InfoTextBrush
                SuccessSurfaceBrush SuccessTextBrush DiagInfoBorderBrush DiagPassBorderBrush
    Background  SkyGlow FireGlow Vignette
    MainWindow tooltip proxy
                MainToolTipBackgroundBrush MainToolTipBorderBrush MainToolTipBorderThickness
                MainToolTipPadding MainToolTipForegroundBrush MainToolTipMaxWidth
                MainToolTipContentTemplate
  Styles
    Prismforge set  BaseButton PrimaryButton LinkButton NavTab Chip Field LevelField StepButton
                    ChromeButton CloseButton ThumbStyle Eyebrow Body
    Buttons         BaseButtonStyle ChipButtonStyle PrimaryChipButtonStyle UpdateBadgeButtonStyle
                    IconButtonStyle AllCategoryButtonStyle CategoryButtonStyle ToolbarButtonStyle
                    PrimaryActionButtonStyle DangerActionButtonStyle SuccessActionButtonStyle
                    SecondaryActionButtonStyle QuietButtonStyle DiagnosticsButtonStyle
                    FavoriteButtonStyle DialogButtonStyle PrimaryDialogButtonStyle
                    DangerDialogButtonStyle HotkeyButtonStyle
    Text            AppTitleTextStyle AppSubtitleTextStyle VersionTextStyle PageTitleStyle
                    LargePageTitleStyle SectionHeaderStyle RowLabelStyle RowLabelWithInfoStyle
                    InfoToolTipTextStyle TraitBadgeTextStyle TypePillTextStyle NavTabIconStyle
                    TrackedLabelStyle PathStatusBannerTextStyle
    Panels          SidebarPanelStyle DialogPanelStyle InsetPanelStyle InfoPanelStyle
                    StatusPanelStyle SectionCardStyle CardDividerStyle FieldCellStyle
                    DiagnosticsCardStyle StatusBadgeStyle ErrorPanelStyle PathStatusBannerStyle
                    ItemCardStyle ItemThumbStyle TraitBadgeStyle TypePillStyle ToastCardStyle
                    ToastAccentBarStyle RowGridStyle
    Controls        ProfessionalExpanderStyle WeaponModExpanderStyle SearchBoxStyle
                    SettingsTextBoxStyle ItemsListStyle ItemRowContainerStyle ItemsListThumbStyle
                    StatusMarkStyle ModernToggleButtonStyle ModernCheckBoxStyle
                    ModernComboBoxItemStyle ModernComboBoxStyle NavTabControlStyle NavTabItemStyle
                    SegmentOptionStyle ThemeOptionStyle InfoToolTipStyle SpawnProgressBarStyle
                    SliderFillRepeatButton
    Implicit        ScrollBar ToolTip Slider ProgressBar Hyperlink
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:Remnant2UnlockerApp.Controls">

    <sys:Boolean x:Key="True">True</sys:Boolean>

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <controls:TrackedConverter x:Key="Tracked"/>

    <!-- Classic labels are shown as written -->
    <DataTemplate x:Key="TrackedTextTemplate">
        <TextBlock Text="{Binding}"/>
    </DataTemplate>

    <!-- ═══ Palette (tokens mapped onto the closest Classic colour) ═══ -->
    <Color x:Key="Soot">#101116</Color>
    <Color x:Key="Char">#1A1D27</Color>
    <Color x:Key="Ash">#252936</Color>
    <Color x:Key="AshHi">#33405F</Color>
    <Color x:Key="Hairline">#303645</Color>
    <Color x:Key="Bronze">#33405F</Color>
    <Color x:Key="Bone">#F2F2F2</Color>
    <Color x:Key="BoneDim">#D8DCE5</Color>
    <Color x:Key="BoneFaint">#8F95A3</Color>
    <Color x:Key="Ember">#2563EB</Color>
    <Color x:Key="EmberHi">#3B82F6</Color>
    <Color x:Key="Pending">#D97706</Color>

    <SolidColorBrush x:Key="SootBrush" Color="{StaticResource Soot}"/>
    <SolidColorBrush x:Key="CharBrush" Color="{StaticResource Char}"/>
    <SolidColorBrush x:Key="AshBrush" Color="{StaticResource Ash}"/>
    <SolidColorBrush x:Key="AshHiBrush" Color="{StaticResource AshHi}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}"/>
    <SolidColorBrush x:Key="BronzeBrush" Color="{StaticResource Bronze}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Bone}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource BoneDim}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource BoneFaint}"/>
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource Ember}"/>
    <SolidColorBrush x:Key="EmberHiBrush" Color="{StaticResource EmberHi}"/>
    <SolidColorBrush x:Key="PendingBrush" Color="{StaticResource Pending}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FACC15"/>
    <SolidColorBrush x:Key="BadBrush" Color="#DC2626"/>

    <!-- ═══ Role brushes ═══ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101116"/>
    <SolidColorBrush x:Key="StatusTextBrush" Color="#B8BFCC"/>
    <SolidColorBrush x:Key="HintTextBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="HighlightTextBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="CodeTextBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="ToastMessageBrush" Color="#B7BBC7"/>
    <SolidColorBrush x:Key="ToastInfoBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="ToastSuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="ToastWarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="ToastErrorBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#242837"/>
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#173B24"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#86EFAC"/>
    <SolidColorBrush x:Key="DiagInfoBorderBrush" Color="#2C4A6E"/>
    <SolidColorBrush x:Key="DiagPassBorderBrush" Color="#1F3D2B"/>

    <!-- Background layers exist in every theme; Classic has none. -->
    <SolidColorBrush x:Key="SkyGlow" Color="Transparent"/>
    <SolidColorBrush x:Key="FireGlow" Color="Transparent"/>
    <SolidColorBrush x:Key="Vignette" Color="Transparent"/>

    <!-- MainWindow's own tooltip look (transparent, default text) — see MainWindow.xaml. -->
    <SolidColorBrush x:Key="MainToolTipBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="MainToolTipBorderBrush" Color="Transparent"/>
    <Thickness x:Key="MainToolTipBorderThickness">0</Thickness>
    <Thickness x:Key="MainToolTipPadding">0</Thickness>
    <SolidColorBrush x:Key="MainToolTipForegroundBrush" Color="#575757"/>
    <sys:Double x:Key="MainToolTipMaxWidth">Infinity</sys:Double>
    <DataTemplate x:Key="MainToolTipContentTemplate">
        <TextBlock Text="{Binding}"/>
    </DataTemplate>

    <!-- ═══════════════════════════ Buttons ═══════════════════════════ -->

    <!-- MainWindow button base (was MainWindow's implicit Button style) -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#D8DCE5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#252936"/>
        <Setter Property="BorderBrush" Value="#33405F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChipBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ChipBorder" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ChipBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryChipButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="BorderBrush" Value="#2563EB"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style x:Key="UpdateBadgeButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
        <Setter Property="Foreground" Value="#93C5FD"/>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="#1A1D27"/>
        <Setter Property="Foreground" Value="#D8DCE5"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="AllCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Background" Value="#1A1D27"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="CategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="#1A1D27"/>
        <Setter Property="Foreground" Value="#D8DCE5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#252936"/>
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#2563EB"/>
    </Style>

    <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#7C2D12"/>
    </Style>

    <Style x:Key="SuccessActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#16A34A"/>
    </Style>

    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#3A3F51"/>
    </Style>

    <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#252936"/>
        <Setter Property="Foreground" Value="#D8DCE5"/>
    </Style>

    <Style x:Key="DiagnosticsButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasDiagnosticIssue}" Value="True">
                <Setter Property="Foreground" Value="#FACC15"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FavoriteButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#252936"/>
        <Setter Property="Foreground" Value="#8F95A3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Content" Value="☆"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                <Setter Property="Content" Value="★"/>
                <Setter Property="Foreground" Value="#FACC15"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Dialog button base (was the implicit Button style of Settings / Update / Spawn Progress) -->
    <Style x:Key="DialogButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#252936"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.TextAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#33405F"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1F2D4A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
        <Setter Property="Background" Value="#2563EB"/>
    </Style>

    <Style x:Key="DangerDialogButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#7C2D12"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#9A3412"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#5B2110"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hotkey capture buttons need extra room + wrapping so long values (e.g. "MiddleMouseButton")
         never get clipped or crowd neighbouring content. No BasedOn: in Classic these keep the
         default Windows button look, exactly as before the theme split. -->
    <Style x:Key="HotkeyButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>

    <!-- ═══════════════════════════ Text ═══════════════════════════ -->

    <Style x:Key="AppTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F1F1F1"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="AppSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#8F95A3"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="VersionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#5B6272"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="LargePageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleStyle}">
        <Setter Property="FontSize" Value="22"/>
    </Style>

    <!-- Section label above a card; a ContentControl so themes can re-template the text. -->
    <Style x:Key="SectionHeaderStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="#8F95A3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="RowLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#D8DCE5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <!-- A row label that also carries an info tooltip, rendered as one wrappable TextBlock so the
         "ⓘ" glyph can never be pushed off past a fixed-width neighbour. -->
    <Style x:Key="RowLabelWithInfoStyle" TargetType="TextBlock" BasedOn="{StaticResource RowLabelStyle}">
        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
    </Style>

    <Style x:Key="InfoToolTipTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F2F2F2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TraitBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FACC15"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="DlcBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#C4B5FD"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="OwnedBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#86EFAC"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="TypePillTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#D8DCE5"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="NavTabIconStyle" TargetType="TextBlock"/>

    <Style x:Key="TrackedLabelStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
    </Style>

    <Style x:Key="PathStatusBannerTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FCA5A5"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsGamePathValid}" Value="True">
                <Setter Property="Foreground" Value="#86EFAC"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════ Panels ═══════════════════════════ -->

    <Style x:Key="SidebarPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#171922"/>
    </Style>

    <Style x:Key="DialogPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#1A1D27"/>
        <Setter Property="BorderBrush" Value="#33405F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <Style x:Key="InsetPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#151821"/>
        <Setter Property="BorderBrush" Value="#303645"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="InfoPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#252936"/>
        <Setter Property="BorderBrush" Value="#33405F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="StatusPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#1A1D27"/>
        <Setter Property="BorderBrush" Value="#273044"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#1E212B"/>
        <Setter Property="BorderBrush" Value="#33405F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>

    <Style x:Key="CardDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="#303645"/>
        <Setter Property="Margin" Value="0,4,0,16"/>
    </Style>

    <Style x:Key="FieldCellStyle" TargetType="Border">
        <Setter Property="Background" Value="#1A1D27"/>
        <Setter Property="BorderBrush" Value="#2A2E3C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style x:Key="DiagnosticsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#252936"/>
        <Setter Property="BorderBrush" Value="#33405F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#7F1D1D"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <Style x:Key="ErrorPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#2A1D1D"/>
        <Setter Property="BorderBrush" Value="#7C2D12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- Classic has always shown this banner red, also for a valid path (a local Background used
         to override the green trigger). Kept that way so Classic looks exactly as before. -->
    <Style x:Key="PathStatusBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="#7F1D1D"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="ItemCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#1A1D27"/>
        <Setter Property="BorderBrush" Value="#232838"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="10,6"/>
        <Setter Property="MinHeight" Value="92"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                <Setter Property="Background" Value="#1F2D4A"/>
                <Setter Property="BorderBrush" Value="#3B82F6"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsMouseOver}" Value="True">
                <Setter Property="Background" Value="#202637"/>
                <Setter Property="BorderBrush" Value="#33405F"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsTraitLocked}" Value="True">
                <Setter Property="Opacity" Value="0.48"/>
                <Setter Property="BorderBrush" Value="#3B2F13"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ItemThumbStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
