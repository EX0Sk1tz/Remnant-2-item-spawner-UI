<!--
  ═══ Theme: Remnant ═══════════════════════════════════════════════════════════
  Dark, weathered game UI after the Remnant II key art (same design as Prismforge):
  cool stone greys, bone-white text, the crimson of the "II" logo as brand accent,
  fire-orange embers, a teal halo and golden light. Sharp corners, 1 px hairlines,
  letter-spaced upper-case labels.

  THEME CONTRACT: every theme (Themes/*.xaml) defines exactly the same x:Key set, and
  the views reference those keys only through DynamicResource. ThemeManager swaps the
  whole dictionary at runtime; "Grain" is set by ThemeManager, not by the theme.

  Values
    True · UiFont · MonoFont · Tracked · TrackedTextTemplate
    Colors      Soot Char Ash AshHi Hairline Bronze Bone BoneDim BoneFaint Ember EmberHi Pending
    Palette     SootBrush CharBrush AshBrush AshHiBrush HairlineBrush BronzeBrush TextBrush
                TextDimBrush TextFaintBrush EmberBrush EmberHiBrush PendingBrush GoodBrush
                WarnBrush BadBrush
    Roles       WindowBackgroundBrush StatusTextBrush HintTextBrush AccentTextBrush
                HighlightTextBrush CodeTextBrush ToastMessageBrush ToastInfoBrush
                ToastSuccessBrush ToastWarningBrush ToastErrorBrush SubtleDividerBrush
                ErrorSurfaceBrush ErrorTextBrush InfoSurfaceBrush InfoTextBrush
                SuccessSurfaceBrush SuccessTextBrush DiagInfoBorderBrush DiagPassBorderBrush
    Background  SkyGlow FireGlow Vignette
    MainWindow tooltip proxy
                MainToolTipBackgroundBrush MainToolTipBorderBrush MainToolTipBorderThickness
                MainToolTipPadding MainToolTipForegroundBrush MainToolTipMaxWidth
                MainToolTipContentTemplate
  Styles
    Prismforge set  BaseButton PrimaryButton LinkButton NavTab Chip Field LevelField StepButton
                    ChromeButton CloseButton ThumbStyle Eyebrow Body
    Buttons         BaseButtonStyle ChipButtonStyle PrimaryChipButtonStyle UpdateBadgeButtonStyle
                    IconButtonStyle AllCategoryButtonStyle CategoryButtonStyle ToolbarButtonStyle
                    PrimaryActionButtonStyle DangerActionButtonStyle SuccessActionButtonStyle
                    SecondaryActionButtonStyle QuietButtonStyle DiagnosticsButtonStyle
                    FavoriteButtonStyle DialogButtonStyle PrimaryDialogButtonStyle
                    DangerDialogButtonStyle HotkeyButtonStyle
    Text            AppTitleTextStyle AppSubtitleTextStyle VersionTextStyle PageTitleStyle
                    LargePageTitleStyle SectionHeaderStyle RowLabelStyle RowLabelWithInfoStyle
                    InfoToolTipTextStyle TraitBadgeTextStyle TypePillTextStyle NavTabIconStyle
                    TrackedLabelStyle PathStatusBannerTextStyle
    Panels          SidebarPanelStyle DialogPanelStyle InsetPanelStyle InfoPanelStyle
                    StatusPanelStyle SectionCardStyle CardDividerStyle FieldCellStyle
                    DiagnosticsCardStyle StatusBadgeStyle ErrorPanelStyle PathStatusBannerStyle
                    ItemCardStyle ItemThumbStyle TraitBadgeStyle TypePillStyle ToastCardStyle
                    ToastAccentBarStyle RowGridStyle
    Controls        ProfessionalExpanderStyle WeaponModExpanderStyle SearchBoxStyle
                    SettingsTextBoxStyle ItemsListStyle ItemRowContainerStyle ItemsListThumbStyle
                    StatusMarkStyle ModernToggleButtonStyle ModernCheckBoxStyle
                    ModernComboBoxItemStyle ModernComboBoxStyle NavTabControlStyle NavTabItemStyle
                    SegmentOptionStyle ThemeOptionStyle InfoToolTipStyle SpawnProgressBarStyle
                    SliderFillRepeatButton
    Implicit        ScrollBar ToolTip Slider ProgressBar Hyperlink

  Note: only these FontWeights exist in WPF: Thin ExtraLight Light Normal Medium SemiBold Bold
  ExtraBold Black ("SemiLight" fails at startup).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:Remnant2UnlockerApp.Controls">

    <sys:Boolean x:Key="True">True</sys:Boolean>

    <FontFamily x:Key="UiFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <controls:TrackedConverter x:Key="Tracked"/>

    <!-- Upper-case, letter-spaced label for string content. Tracking makes labels wider, so a label
         that no longer fits its fixed-width button (e.g. German "DURCHSUCHEN") is scaled down
         instead of being clipped; labels that fit are never scaled. -->
    <DataTemplate x:Key="TrackedTextTemplate">
        <Viewbox StretchDirection="DownOnly">
            <TextBlock Text="{Binding Converter={StaticResource Tracked}}"/>
        </Viewbox>
    </DataTemplate>

    <!-- ═══ Palette: soot, ash, bone and ember ═══ -->
    <Color x:Key="Soot">#17181A</Color>
    <Color x:Key="Char">#1D1F21</Color>
    <Color x:Key="Ash">#25282A</Color>
    <Color x:Key="AshHi">#2F3336</Color>
    <Color x:Key="Hairline">#3E4341</Color>
    <Color x:Key="Bronze">#6A645A</Color>
    <Color x:Key="Bone">#ECE5D8</Color>
    <Color x:Key="BoneDim">#B2AA9C</Color>
    <Color x:Key="BoneFaint">#817B70</Color>
    <Color x:Key="Ember">#C8323A</Color>
    <Color x:Key="EmberHi">#E24A50</Color>
    <Color x:Key="Pending">#F08A3C</Color>

    <SolidColorBrush x:Key="SootBrush" Color="{StaticResource Soot}"/>
    <SolidColorBrush x:Key="CharBrush" Color="{StaticResource Char}"/>
    <SolidColorBrush x:Key="AshBrush" Color="{StaticResource Ash}"/>
    <SolidColorBrush x:Key="AshHiBrush" Color="{StaticResource AshHi}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Hairline}"/>
    <SolidColorBrush x:Key="BronzeBrush" Color="{StaticResource Bronze}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Bone}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource BoneDim}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource BoneFaint}"/>
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource Ember}"/>
    <SolidColorBrush x:Key="EmberHiBrush" Color="{StaticResource EmberHi}"/>
    <SolidColorBrush x:Key="PendingBrush" Color="{StaticResource Pending}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#6CC4C0"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#E3B55C"/>
    <SolidColorBrush x:Key="BadBrush" Color="#E0533F"/>

    <!-- ═══ Role brushes ═══ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource Soot}"/>
    <SolidColorBrush x:Key="StatusTextBrush" Color="{StaticResource BoneDim}"/>
    <SolidColorBrush x:Key="HintTextBrush" Color="{StaticResource BoneFaint}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource EmberHi}"/>
    <SolidColorBrush x:Key="HighlightTextBrush" Color="#6CC4C0"/>
    <SolidColorBrush x:Key="CodeTextBrush" Color="#E3B55C"/>
    <SolidColorBrush x:Key="ToastMessageBrush" Color="{StaticResource BoneDim}"/>
    <SolidColorBrush x:Key="ToastInfoBrush" Color="{StaticResource Ember}"/>
    <SolidColorBrush x:Key="ToastSuccessBrush" Color="#6CC4C0"/>
    <SolidColorBrush x:Key="ToastWarningBrush" Color="#E3B55C"/>
    <SolidColorBrush x:Key="ToastErrorBrush" Color="#E0533F"/>
    <SolidColorBrush x:Key="SubtleDividerBrush" Color="{StaticResource Hairline}"/>
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#3A1A1B"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#EC7A68"/>
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="{StaticResource AshHi}"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="{StaticResource BoneDim}"/>
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#1A2F2E"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#6CC4C0"/>
    <SolidColorBrush x:Key="DiagInfoBorderBrush" Color="{StaticResource Hairline}"/>
    <SolidColorBrush x:Key="DiagPassBorderBrush" Color="#2F4A48"/>

    <!-- ═══ Key-art lighting: cool light from above, embers from below ═══ -->
    <RadialGradientBrush x:Key="SkyGlow" Center="0.55,-0.1" GradientOrigin="0.55,-0.1" RadiusX="0.75" RadiusY="0.7">
        <GradientStop Color="#2A9FD6D0" Offset="0"/>
        <GradientStop Color="#10E3C58A" Offset="0.45"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="FireGlow" Center="0.5,1.15" GradientOrigin="0.5,1.15" RadiusX="0.8" RadiusY="0.55">
        <GradientStop Color="#40F08A3C" Offset="0"/>
        <GradientStop Color="#18C8323A" Offset="0.5"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <!-- Vignette laid over the whole window -->
    <RadialGradientBrush x:Key="Vignette" Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.9">
        <GradientStop Color="#00000000" Offset="0.45"/>
        <GradientStop Color="#70000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- MainWindow tooltips: same look as the implicit tooltip below -->
    <SolidColorBrush x:Key="MainToolTipBackgroundBrush" Color="{StaticResource Char}"/>
    <SolidColorBrush x:Key="MainToolTipBorderBrush" Color="{StaticResource Bronze}"/>
    <Thickness x:Key="MainToolTipBorderThickness">1</Thickness>
    <Thickness x:Key="MainToolTipPadding">10,7</Thickness>
    <SolidColorBrush x:Key="MainToolTipForegroundBrush" Color="{StaticResource Bone}"/>
    <sys:Double x:Key="MainToolTipMaxWidth">320</sys:Double>
    <DataTemplate x:Key="MainToolTipContentTemplate">
        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
    </DataTemplate>

    <!-- ═══════════════════════════ Buttons ═══════════════════════════ -->

    <!-- Outline button. Hover/focus border colours are Style triggers (not template triggers) so
         the accent variants below can recolour them. -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BronzeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="hover"
                                Margin="{TemplateBinding BorderThickness}"
                                Background="{StaticResource AshHiBrush}"
                                Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hover" Property="Background" Value="{StaticResource CharBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource TextDimBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="ContentTemplate" Value="{StaticResource TrackedTextTemplate}"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="#4A171B"/>
        <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
        <Setter Property="Foreground" Value="#F2E6D3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                        <Border x:Name="glow" BorderThickness="0" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#55E24A50" Offset="0"/>
                                    <GradientStop Color="#00E24A50" Offset="0.8"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Rectangle Height="2" VerticalAlignment="Bottom" Margin="1,0,1,1" Fill="{StaticResource EmberBrush}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="glow" Property="Opacity" Value="1"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource EmberHiBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource EmberHiBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#361013"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text button for tertiary actions -->
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar navigation tab; Tag=True marks the active page -->
    <Style x:Key="NavTab" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ContentTemplate" Value="{StaticResource TrackedTextTemplate}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="14,0" VerticalAlignment="Center"/>
                        <Rectangle x:Name="bar" Height="2" VerticalAlignment="Bottom" Margin="10,0"
                                   Fill="{StaticResource EmberBrush}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip; Tag=True marks the active filter -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ContentTemplate" Value="{StaticResource TrackedTextTemplate}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextDimBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="#4A171B"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square − / + stepper buttons -->
    <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>

    <!-- Title bar buttons (only used by windows with custom chrome) -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource AshHiBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#A0232B"/>
                            <Setter Property="Foreground" Value="#F2E6D3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource Chip}"/>

    <Style x:Key="PrimaryChipButtonStyle" TargetType="Button" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="#4A171B"/>
        <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}"/>
        <Setter Property="Foreground" Value="#F2E6D3"/>
    </Style>

    <Style x:Key="UpdateBadgeButtonStyle" TargetType="Button" BasedOn="{StaticResource Chip}">
        <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
        <Setter Property="BorderBrush" Value="#2F4A48"/>
    </Style>

    <!-- Settings button: square hairline frame with a thin line gear -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" FontWeight="Normal"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AllCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sub-category entry in the sidebar: text row with an ember bar on hover -->
    <Style x:Key="CategoryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Background="Transparent">
                        <Rectangle x:Name="bar" Width="2" HorizontalAlignment="Left" Fill="{StaticResource EmberBrush}" Visibility="Hidden"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource AshBrush}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource AshHiBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="BorderBrush" Value="#7A4424"/>
        <Setter Property="Foreground" Value="{StaticResource PendingBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource PendingBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SuccessActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="BorderBrush" Value="#2F5E5B"/>
        <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource GoodBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Content is a panel (glyph + text), so no tracked text template here -->
    <Style x:Key="DiagnosticsButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
        <Setter Property="ContentTemplate" Value="{x:Null}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasDiagnosticIssue}" Value="True">
