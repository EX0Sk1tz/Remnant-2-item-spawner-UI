    <Style x:Key="FavoriteButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="#C0171819" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <Path x:Name="star"
                              Data="M5,0 L6.2,3.4 L10,3.6 L7,5.9 L8.1,9.5 L5,7.5 L1.9,9.5 L3,5.9 L0,3.6 L3.8,3.4 Z"
                              Stroke="{StaticResource TextFaintBrush}" StrokeThickness="1" StrokeLineJoin="Miter"
                              Fill="Transparent" Width="10" Height="10" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="star" Property="Stroke" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource BronzeBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                            <Setter TargetName="star" Property="Stroke" Value="{StaticResource WarnBrush}"/>
                            <Setter TargetName="star" Property="Fill" Value="{StaticResource WarnBrush}"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
