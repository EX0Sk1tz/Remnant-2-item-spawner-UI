<Window x:Class="Remnant2UnlockerApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remnant 2 Item Spawner"
        Height="760"
        Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="#101116"
        MinHeight="760"
        MinWidth="1320"
        ResizeMode="CanMinimize"
        Topmost="{Binding AlwaysOnTop}">

    <Window.Resources>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"/>

        <Style x:Key="AllCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="CategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="Foreground" Value="#D8DCE5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ProfessionalExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="Outer"
                                Background="#171922"
                                BorderBrush="#273044"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ToggleButton x:Name="HeaderSite"
                                              Grid.Row="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Padding="12,11">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderRoot"
                                                    Background="Transparent"
                                                    CornerRadius="12"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border x:Name="ChevronCircle"
                                                            Grid.Column="0"
                                                            Width="17"
                                                            Height="17"
                                                            CornerRadius="8.5"
                                                            Background="#2F3A56"
                                                            VerticalAlignment="Center">
                                                        <Path x:Name="Chevron"
                                                              Data="M 4 6 L 8.5 10.5 L 13 6"
                                                              Stroke="#D8DCE5"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>

                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="8,0,0,0"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderRoot" Property="Background" Value="#1D2231"/>
                                                    <Setter TargetName="ChevronCircle" Property="Background" Value="#33405F"/>
                                                </Trigger>

                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="HeaderRoot" Property="Background" Value="#1A1D27"/>
                                                    <Setter TargetName="ChevronCircle" Property="Background" Value="#3B82F6"/>
                                                    <Setter TargetName="Chevron" Property="Stroke" Value="#FFFFFF"/>
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>

                                    <TextBlock Text="{TemplateBinding Header}"
                                               Foreground="#F2F2F2"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                </ToggleButton>

                                <Border x:Name="ContentHost"
                                        Grid.Row="1"
                                        Padding="10,0,10,10"
                                        Visibility="Collapsed"
                                        Opacity="0">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentHost" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentHost" Property="Opacity" Value="1"/>
                                <Setter TargetName="Outer" Property="Background" Value="#171922"/>
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#273044"/>
                                <Setter TargetName="Outer" Property="CornerRadius" Value="12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ItemCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="BorderBrush" Value="#232838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="10,6"/>
            <Setter Property="MinHeight" Value="92"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1F2D4A"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Background" Value="#202637"/>
                    <Setter Property="BorderBrush" Value="#33405F"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsTraitLocked}" Value="True">
                    <Setter Property="Opacity" Value="0.48"/>
                    <Setter Property="BorderBrush" Value="#3B2F13"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="Foreground" Value="#D8DCE5"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#171922" Padding="18">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="REMNANT 2"
                                   Foreground="#F1F1F1"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Unlocker Bridge"
                                       Foreground="#8F95A3"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding VersionText}"
                                       Foreground="#5B6272"
                                       FontSize="11"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Content="{Binding UpdateBadgeText}"
                                Command="{Binding ShowUpdatePreviewCommand}"
                                Foreground="#93C5FD"
                                FontSize="11"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                ToolTip="{Binding Loc[Main.UpdateTooltip]}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="⚙"
                            Click="OpenSettings_Click"
                            Style="{StaticResource IconButtonStyle}"/>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBox Text="{Binding CategorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 FontSize="13"
                                 Padding="12,8"
                                 Margin="0,0,0,10"
                                 Background="#1A1D27"
                                 Foreground="#F2F2F2"
                                 BorderBrush="#303645"
                                 BorderThickness="1"
                                 ToolTip="{Binding Loc[Main.SearchSubcategoriesTooltip]}"/>

                        <Button Content="{Binding Loc[Main.All]}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="All"
                                Style="{StaticResource AllCategoryButtonStyle}"/>

                        <Button Content="{Binding Loc[Main.Favorites]}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="Favorites"
                                Style="{StaticResource AllCategoryButtonStyle}"/>

                        <ItemsControl ItemsSource="{Binding CategoryGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Name}"
                                              Style="{StaticResource ProfessionalExpanderStyle}"
                                              IsExpanded="True">
                                        <ItemsControl ItemsSource="{Binding Types}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}"
                                                            Command="{Binding DataContext.SelectTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource CategoryButtonStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="42"
                         FontSize="15"
                         Padding="14,9"
                         Background="#1A1D27"
                         Foreground="#F2F2F2"
                         BorderBrush="#303645"
                         BorderThickness="1"/>

                <Button Grid.Column="1"
                        Content="{Binding Loc[Main.Reload]}"
                        Command="{Binding ReloadCommand}"
                        Height="42"
                        Margin="12,0,0,0"
                        Background="#252936"/>
            </Grid>

            <ListView x:Name="ItemsListView"
                      Grid.Row="1"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      Background="#151821"
                      BorderBrush="#303645"
                      BorderThickness="1"
                      Foreground="#F2F2F2"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.Resources>
                    <Style x:Key="ItemsListThumbStyle" TargetType="Thumb">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="ThumbBorder"
                                            Background="#33405F"
                                            CornerRadius="4"
                                            Margin="2,0"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#3B82F6"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#3B82F6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="10"/>
                        <Setter Property="MinWidth" Value="10"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track"
                                               IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                                              Opacity="0"
                                                              Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                                              Opacity="0"
                                                              Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ItemsListThumbStyle}"/>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="432"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="64"
                                        Height="64"
                                        CornerRadius="12"
                                        Background="#252936"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="?"
                                                   Foreground="#8F95A3"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Image Source="{Binding Image}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="4">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <ProgressBar Width="30"
                                                     Height="30"
                                                     IsIndeterminate="True"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImageLoading}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>

                                        <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,-6,-6,0"
                                                Cursor="Hand"
                                                ToolTip="{Binding DataContext.Loc[Main.ToggleFavoriteTooltip], RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                                    <Setter Property="Background" Value="#252936"/>
                                                    <Setter Property="Foreground" Value="#8F95A3"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Content" Value="☆"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Content" Value="★"/>
                                                            <Setter Property="Foreground" Value="#FACC15"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="8,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#F2F2F2"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Border Background="#3B2F13"
                                                BorderBrush="#FACC15"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="7,2"
                                                Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTraitLocked}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="Requires Summonable Traits"
                                                       Foreground="#FACC15"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Type}"
                                               Foreground="#8F95A3"
                                               FontSize="13"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Background="#252936"
                                        CornerRadius="12"
                                        Padding="10,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Type}"
                                               Foreground="#D8DCE5"
                                               FontSize="12"/>
                                </Border>

                                <Grid Grid.Column="3"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button Content="{Binding DataContext.Loc[Main.Spawn], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="40"
                                                Width="92"
                                                Background="#2563EB"
                                                Click="SpawnItem_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanUseNormalSpawn}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="{Binding DataContext.Loc[Main.Force], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="40"
                                                Width="92"
                                                Margin="10,0,0,0"
                                                Background="#7C2D12"
                                                Click="ForceConsoleSpawnItem_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanUseNormalSpawn}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="{Binding DataContext.Loc[Main.Spawn], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="40"
                                                Width="92"
                                                Background="#2563EB"
                                                Click="SummonTrait_Click"
                                                ToolTip="{Binding DataContext.Loc[Main.SummonTraitTooltip], RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsSummonableTraitsMod}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CanUseTraitCommands}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="{Binding DataContext.Loc[Main.Add], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="40"
                                                Width="92"
                                                Margin="10,0,0,0"
                                                Background="#16A34A"
                                                Click="AddTrait_Click"
                                                ToolTip="{Binding DataContext.Loc[Main.AddTraitTooltip], RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsSummonableTraitsMod}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CanUseTraitCommands}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="{Binding DataContext.Loc[Main.Copy], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="40"
                                                Width="92"
                                                Margin="10,0,0,0"
                                                Background="#3A3F51"
                                                Click="CopyCommand_Click"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="1"
                                            Height="34"
                                            Background="#303645"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    <Button Grid.Column="2"
                                            Content="{Binding DataContext.Loc[Main.Wiki], RelativeSource={RelativeSource AncestorType=Window}}"
                                            Height="40"
                                            Width="82"
                                            Background="#252936"
                                            Foreground="#D8DCE5"
                                            Click="OpenWiki_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="390"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="#B8BFCC"
                           VerticalAlignment="Center"
                           FontSize="14"/>

                <Button Grid.Column="1"
                        Click="OpenDiagnostics_Click"
                        Height="36"
                        Margin="8,0,0,0"
                        Background="#252936"
                        Foreground="#D8DCE5"
                        ToolTip="{Binding Loc[Main.DiagnosticsTooltip]}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDiagnosticIssue}" Value="True">
                                    <Setter Property="Foreground" Value="#FACC15"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="ⓘ"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDiagnosticIssue}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding Loc[Main.Diagnostics]}"
                                   FontSize="12"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDiagnosticIssue}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding DiagnosticHint}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="140">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDiagnosticIssue}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Border Grid.Column="2"
                        Background="#1A1D27"
                        BorderBrush="#273044"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="44"
                        Margin="8,0,0,0"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0"
                                 Width="8"
                                 Height="8"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGamePathValid}" Value="True">
                                            <Setter Property="Fill" Value="#22C55E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,8,0">
                            <TextBlock Text="{Binding GamePathStatus}"
                                       Foreground="#F2F2F2"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding GamePathDisplay}"
                                       Foreground="#8F95A3"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="{Binding Loc[Main.Browse]}"
                                Command="{Binding SelectGamePathCommand}"
                                Height="30"
                                Background="#252936"
                                Foreground="#D8DCE5"/>
                    </Grid>
                </Border>

                <Button Grid.Column="3"
                        Content="{Binding Loc[Main.SpawnGroup]}"
                        Command="{Binding UnlockGroupCommand}"
                        Height="44"
                        Margin="8,0,0,0"
                        Background="#3A3F51"/>
            </Grid>
        </Grid>

        <ItemsControl Grid.Column="0"
                      Grid.ColumnSpan="2"
                      ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,20,92"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="ToastCard"
                            Width="240"
                            Background="#1A1D27"
                            BorderBrush="#33405F"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,8,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform X="60"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0"
                                                         Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AccentBar"
                                    Grid.Column="0"
                                    Background="#2563EB"
                                    CornerRadius="2"
                                    Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="#F2F2F2"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding Message}"
                                           Foreground="#B7BBC7"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="ActionLink"
                                           Text="{Binding ActionText}"
                                           Foreground="#60A5FA"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="ToastAction_Click"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="&#10005;"
                                       Foreground="#6B7280"
                                       FontSize="10"
                                       Cursor="Hand"
                                       VerticalAlignment="Top"
                                       Margin="6,0,0,0"
                                       MouseLeftButtonUp="ToastClose_Click"/>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Type}" Value="Success">
                            <Setter TargetName="AccentBar" Property="Background" Value="#16A34A"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Warning">
                            <Setter TargetName="AccentBar" Property="Background" Value="#D97706"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Error">
                            <Setter TargetName="AccentBar" Property="Background" Value="#DC2626"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionText}" Value="{x:Null}">
                            <Setter TargetName="ActionLink" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>