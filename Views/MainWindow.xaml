<Window x:Class="Remnant2UnlockerApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remnant 2 Item Spawner"
        Height="760"
        Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        MinHeight="760"
        MinWidth="1320"
        ResizeMode="CanMinimize"
        Topmost="{Binding AlwaysOnTop}">

    <Window.Resources>
        <!-- This window's tooltips have their own look; every value comes from the theme so a
             switch updates them (an implicit style can't be based on a DynamicResource). -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource MainToolTipBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MainToolTipBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource MainToolTipBorderThickness}"/>
            <Setter Property="Padding" Value="{DynamicResource MainToolTipPadding}"/>
            <Setter Property="Foreground" Value="{DynamicResource MainToolTipForegroundBrush}"/>
            <Setter Property="MaxWidth" Value="{DynamicResource MainToolTipMaxWidth}"/>
            <Setter Property="ContentTemplate" Value="{DynamicResource MainToolTipContentTemplate}"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Background layers (transparent in themes that don't use them) -->
        <Rectangle Grid.ColumnSpan="2" Fill="{DynamicResource Grain}" IsHitTestVisible="False"/>
        <Rectangle Grid.ColumnSpan="2" Fill="{DynamicResource SkyGlow}" IsHitTestVisible="False"/>
        <Rectangle Grid.ColumnSpan="2" Fill="{DynamicResource FireGlow}" IsHitTestVisible="False"/>
        <Rectangle Grid.ColumnSpan="2" Fill="{DynamicResource Vignette}" IsHitTestVisible="False"/>

        <Border Grid.Column="0" Style="{DynamicResource SidebarPanelStyle}" Padding="18">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="REMNANT 2"
                                   Style="{DynamicResource AppTitleTextStyle}"
                                   Margin="0,0,0,4"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Unlocker Bridge"
                                       Style="{DynamicResource AppSubtitleTextStyle}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding VersionText}"
                                       Style="{DynamicResource VersionTextStyle}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Content="{Binding UpdateBadgeText}"
                                Command="{Binding ShowUpdatePreviewCommand}"
                                Style="{DynamicResource UpdateBadgeButtonStyle}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolVis}}"
                                FontSize="11"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                ToolTip="{Binding Loc[Main.UpdateTooltip]}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="⚙"
                            Click="OpenSettings_Click"
                            Style="{DynamicResource IconButtonStyle}"/>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBox Text="{Binding CategorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource SearchBoxStyle}"
                                 Height="38"
                                 FontSize="13"
                                 Padding="12,8"
                                 Margin="0,0,0,10"
                                 ToolTip="{Binding Loc[Main.SearchSubcategoriesTooltip]}"/>

                        <Button Content="{Binding Loc[Main.All]}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="All"
                                Style="{DynamicResource AllCategoryButtonStyle}"/>

                        <Button Content="{Binding Loc[Main.Favorites]}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="Favorites"
                                Style="{DynamicResource AllCategoryButtonStyle}"/>

                        <ItemsControl ItemsSource="{Binding CategoryGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Name}"
                                              Style="{DynamicResource ProfessionalExpanderStyle}"
                                              IsExpanded="True">
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Type}"
                                                            Style="{DynamicResource CategoryButtonStyle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Type}"/>
                                                            <TextBlock Text="{Binding ProgressText}"
                                                                       Foreground="{DynamicResource TextFaintBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="Normal"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding HasProgress, Converter={StaticResource BoolVis}}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource SearchBoxStyle}"
                         Height="42"
                         FontSize="15"
                         Padding="14,9"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ContentFilterOptions}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="DisplayName"
                          SelectedValue="{Binding ContentFilter}"
                          Style="{DynamicResource ModernComboBoxStyle}"
                          Height="42"
                          Margin="12,0,0,0"
                          ToolTip="{Binding Loc[Main.ContentFilterTooltip]}"/>

                <CheckBox Grid.Column="2"
                          Content="{Binding Loc[Main.MissingOnly]}"
                          IsChecked="{Binding ShowMissingOnly}"
                          IsEnabled="{Binding HasOwnedItemsScan}"
                          Style="{DynamicResource ModernCheckBoxStyle}"
                          VerticalAlignment="Center"
                          Margin="16,0,4,0"
                          ToolTip="{Binding Loc[Main.MissingOnlyTooltip]}"
                          ToolTipService.ShowOnDisabled="True"/>

                <Button Grid.Column="3"
                        Content="{Binding Loc[Main.ScanInventory]}"
                        Command="{Binding ScanInventoryCommand}"
                        Style="{DynamicResource ToolbarButtonStyle}"
                        Height="42"
                        Margin="12,0,0,0"
                        ToolTip="{Binding Loc[Main.ScanInventoryTooltip]}"/>

                <Button Grid.Column="4"
                        Content="{Binding Loc[Main.Reload]}"
                        Command="{Binding ReloadCommand}"
                        Style="{DynamicResource ToolbarButtonStyle}"
                        Height="42"
                        Margin="12,0,0,0"/>
            </Grid>

            <!-- Collection bar: what the latest inventory scan says about the selected subcategory -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Grid instead of a horizontal StackPanel so the scan time can trim with "…"
                     rather than running under the Spawn Missing button on long summaries. -->
                <Grid Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CollectionSummaryText}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding LastScanText}"
                               ToolTip="{Binding LastScanText}"
                               Foreground="{DynamicResource TextFaintBrush}"
                               FontSize="12"
                               Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Grid>

                <Button Grid.Column="1"
                        Content="{Binding Loc[Main.SpawnMissing]}"
                        Command="{Binding SpawnMissingCommand}"
                        Style="{DynamicResource SecondaryActionButtonStyle}"
                        Visibility="{Binding HasOwnedItemsScan, Converter={StaticResource BoolVis}}"
                        Height="34"
                        Padding="14,0"
                        MinWidth="150"
                        ToolTip="{Binding Loc[Main.SpawnMissingTooltip]}"/>
            </Grid>

            <ListView x:Name="ItemsListView"
                      Grid.Row="2"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      Style="{DynamicResource ItemsListStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource ItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="432"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{DynamicResource ItemThumbStyle}"
                                        Width="64"
                                        Height="64"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="?"
                                                   Foreground="{DynamicResource TextFaintBrush}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolVisInv}}"/>

                                        <Image Source="{Binding Image}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="4"
                                               Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}"/>

                                        <ProgressBar Width="30"
                                                     Height="30"
                                                     IsIndeterminate="True"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsImageLoading, Converter={StaticResource BoolVis}}"/>

                                        <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource FavoriteButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,-6,-6,0"
                                                Cursor="Hand"
                                                ToolTip="{Binding DataContext.Loc[Main.ToggleFavoriteTooltip], RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="8,0,16,0">
                                    <!-- Name, badges, category. Without badges the badge line is hidden, so the
                                         category sits directly under the name; long names trim. -->
                                    <TextBlock Text="{Binding Name}"
                                               ToolTip="{Binding Name}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- WrapPanel only as a safety net: the badges fit on one line in practice -->
                                    <WrapPanel Orientation="Horizontal"
                                               Margin="0,3,0,0"
                                               Visibility="{Binding HasBadges, Converter={StaticResource BoolVis}}">
                                        <Border Style="{DynamicResource TraitBadgeStyle}"
                                                Margin="0,2,8,2"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsTraitLocked, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Requires Summonable Traits"
                                                       Style="{DynamicResource TraitBadgeTextStyle}"/>
                                        </Border>

                                        <Border Style="{DynamicResource DlcBadgeStyle}"
                                                Margin="0,2,8,2"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding DlcTooltip}"
                                                Visibility="{Binding IsDlc, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding DlcBadgeText}"
                                                       Style="{DynamicResource DlcBadgeTextStyle}"/>
                                        </Border>

                                        <Border Style="{DynamicResource OwnedBadgeStyle}"
                                                Margin="0,2,8,2"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsOwned, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding DataContext.Loc[Main.Owned], RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Style="{DynamicResource OwnedBadgeTextStyle}"/>
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Type}"
                                               Foreground="{DynamicResource TextFaintBrush}"
                                               FontSize="13"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Style="{DynamicResource TypePillStyle}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="0,0,20,0">
                                    <TextBlock Text="{Binding Type}"
                                               Style="{DynamicResource TypePillTextStyle}"/>
                                </Border>

                                <Grid Grid.Column="3"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button Content="{Binding DataContext.Loc[Main.Spawn], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{DynamicResource PrimaryActionButtonStyle}"
                                                Visibility="{Binding CanUseNormalSpawn, Converter={StaticResource BoolVis}}"
                                                Height="40"
                                                Width="92"
                                                Click="SpawnItem_Click"/>

                                        <Button Content="{Binding DataContext.Loc[Main.Force], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{DynamicResource DangerActionButtonStyle}"
                                                Visibility="{Binding CanUseNormalSpawn, Converter={StaticResource BoolVis}}"
                                                Height="40"
                                                Width="92"
                                                Margin="10,0,0,0"
                                                Click="ForceConsoleSpawnItem_Click"/>

                                        <Button Content="{Binding DataContext.Loc[Main.Spawn], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{DynamicResource PrimaryActionButtonStyle}"
                                                Visibility="{Binding NeedsSummonableTraitsMod, Converter={StaticResource BoolVis}}"
                                                IsEnabled="{Binding CanUseTraitCommands}"
                                                Opacity="{Binding CanUseTraitCommands, Converter={StaticResource BoolDim}}"
                                                Height="40"
                                                Width="92"
                                                Click="SummonTrait_Click"
                                                ToolTip="{Binding DataContext.Loc[Main.SummonTraitTooltip], RelativeSource={RelativeSource AncestorType=Window}}"/>

                                        <Button Content="{Binding DataContext.Loc[Main.Add], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{DynamicResource SuccessActionButtonStyle}"
                                                Visibility="{Binding NeedsSummonableTraitsMod, Converter={StaticResource BoolVis}}"
                                                IsEnabled="{Binding CanUseTraitCommands}"
                                                Opacity="{Binding CanUseTraitCommands, Converter={StaticResource BoolDim}}"
                                                Height="40"
                                                Width="92"
                                                Margin="10,0,0,0"
                                                Click="AddTrait_Click"
                                                ToolTip="{Binding DataContext.Loc[Main.AddTraitTooltip], RelativeSource={RelativeSource AncestorType=Window}}"/>

                                        <Button Content="{Binding DataContext.Loc[Main.Copy], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{DynamicResource SecondaryActionButtonStyle}"
                                                Height="40"
                                                Width="92"
                                                Margin="10,0,0,0"
                                                Click="CopyCommand_Click"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="1"
                                            Height="34"
                                            Background="{DynamicResource HairlineBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    <Button Grid.Column="2"
                                            Content="{Binding DataContext.Loc[Main.Wiki], RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{DynamicResource QuietButtonStyle}"
                                            Height="40"
                                            Width="82"
                                            Click="OpenWiki_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="390"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource StatusTextBrush}"
                           VerticalAlignment="Center"
                           FontSize="14"/>

                <Button Grid.Column="1"
                        Click="OpenDiagnostics_Click"
                        Style="{DynamicResource DiagnosticsButtonStyle}"
                        Height="36"
                        Margin="8,0,0,0"
                        ToolTip="{Binding Loc[Main.DiagnosticsTooltip]}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="ⓘ"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,6,0"
                                   Visibility="{Binding HasDiagnosticIssue, Converter={StaticResource BoolVis}}"/>

                        <ContentControl Content="{Binding Loc[Main.Diagnostics]}"
                                        Style="{DynamicResource TrackedLabelStyle}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Visibility="{Binding HasDiagnosticIssue, Converter={StaticResource BoolVisInv}}"/>

                        <TextBlock Text="{Binding DiagnosticHint}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="140"
                                   Visibility="{Binding HasDiagnosticIssue, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="2"
                        Style="{DynamicResource StatusPanelStyle}"
                        Height="44"
                        Margin="8,0,0,0"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>

                        <Control Grid.Column="0"
                                 Style="{DynamicResource StatusMarkStyle}"
                                 Tag="{Binding IsGamePathValid}"
                                 VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,8,0">
                            <TextBlock Text="{Binding GamePathStatus}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding GamePathDisplay}"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="{Binding Loc[Main.Browse]}"
                                Command="{Binding SelectGamePathCommand}"
                                Style="{DynamicResource QuietButtonStyle}"
                                Height="30"/>
                    </Grid>
                </Border>

                <Button Grid.Column="3"
                        Content="{Binding Loc[Main.SpawnGroup]}"
                        Command="{Binding UnlockGroupCommand}"
                        Style="{DynamicResource SecondaryActionButtonStyle}"
                        Height="44"
                        Margin="8,0,0,0"/>
            </Grid>
        </Grid>

        <ItemsControl Grid.Column="0"
                      Grid.ColumnSpan="2"
                      ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,20,92"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="ToastCard"
                            Style="{DynamicResource ToastCardStyle}"
                            Width="240"
                            Margin="0,8,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform X="60"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0"
                                                         Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AccentBar"
                                    Grid.Column="0"
                                    Style="{DynamicResource ToastAccentBarStyle}"
                                    Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding Message}"
                                           Foreground="{DynamicResource ToastMessageBrush}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="ActionLink"
                                           Text="{Binding ActionText}"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="ToastAction_Click"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="&#10005;"
                                       Foreground="{DynamicResource HintTextBrush}"
                                       FontSize="10"
                                       Cursor="Hand"
                                       VerticalAlignment="Top"
                                       Margin="6,0,0,0"
                                       MouseLeftButtonUp="ToastClose_Click"/>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Type}" Value="Success">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource ToastSuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Warning">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource ToastWarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Error">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource ToastErrorBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionText}" Value="{x:Null}">
                            <Setter TargetName="ActionLink" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
