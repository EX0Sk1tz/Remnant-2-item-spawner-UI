<Window x:Class="Remnant2UnlockerApp.Views.InstallAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[Install.Title]}"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFont}">

    <Grid>
        <Rectangle Fill="{DynamicResource Grain}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource SkyGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource FireGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource Vignette}" IsHitTestVisible="False"/>

        <Border Margin="18" Padding="22" Style="{DynamicResource DialogPanelStyle}">
            <StackPanel>
                <TextBlock Text="{Binding Loc[Install.Title]}" Style="{DynamicResource LargePageTitleStyle}" TextWrapping="Wrap"/>

                <TextBlock Text="{Binding Loc[Install.Intro]}"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,18"/>

                <ContentControl Content="{Binding Loc[Install.Folder]}" Style="{DynamicResource SectionHeaderStyle}"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding InstallDir, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource SettingsTextBoxStyle}"
                             TextAlignment="Left"
                             Padding="8,0"
                             Margin="0,0,10,0"
                             AutomationProperties.Name="Install folder"/>

                    <Button Grid.Column="1"
                            Content="{Binding Loc[Main.Browse]}"
                            Click="Browse_Click"
                            Style="{DynamicResource ChipButtonStyle}"/>
                </Grid>

                <TextBlock Text="{Binding Loc[Install.ExistingInstall]}"
                           Foreground="{DynamicResource HintTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding HasExistingInstall, Converter={StaticResource BoolVis}}"/>

                <CheckBox Content="{Binding Loc[Install.DesktopShortcut]}"
                          IsChecked="{Binding CreateShortcut}"
                          Style="{DynamicResource ModernCheckBoxStyle}"
                          Margin="0,8,0,0"/>

                <Border Style="{DynamicResource ErrorPanelStyle}" Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="{Binding Loc[Install.RunPortable]}"
                            Click="RunPortable_Click"
                            Style="{DynamicResource ChipButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="{Binding Loc[Install.Install]}"
                            Click="Install_Click"
                            Style="{DynamicResource PrimaryChipButtonStyle}"
                            MinWidth="110"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
