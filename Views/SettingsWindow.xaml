<Window x:Class="Remnant2UnlockerApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Remnant2UnlockerApp.Controls"
        Title="Settings"
        Width="1050"
        Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFont}">

    <Grid>
        <!-- Background layers (transparent in themes that don't use them) -->
        <Rectangle Fill="{DynamicResource Grain}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource SkyGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource FireGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource Vignette}" IsHitTestVisible="False"/>

        <Border Margin="18"
                Padding="18"
                Style="{DynamicResource DialogPanelStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Loc[Settings.Title]}"
                           Style="{DynamicResource PageTitleStyle}"
                           Margin="0,0,0,18"/>

                <TabControl Grid.Row="1"
                            Style="{DynamicResource NavTabControlStyle}"
                            ItemContainerStyle="{DynamicResource NavTabItemStyle}">

                    <!-- ================= General ================= -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="15" Width="22" TextAlignment="Center" Style="{DynamicResource NavTabIconStyle}"/>
                                <ContentControl Content="{Binding Loc[Settings.TabGeneral]}" Margin="8,0,0,0" Style="{DynamicResource TrackedLabelStyle}"/>
                            </StackPanel>
                        </TabItem.Header>

                        <StackPanel Margin="0,0,0,4">

                            <Border Style="{DynamicResource SectionCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Loc[Settings.AlwaysOnTop]}"
                                               Style="{DynamicResource RowLabelStyle}"/>

                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding AlwaysOnTop}"
                                                  Style="{DynamicResource ModernToggleButtonStyle}"/>
                                </Grid>
                            </Border>

                            <ContentControl Content="{Binding Loc[Settings.Wiki]}" Style="{DynamicResource SectionHeaderStyle}"/>

                            <Border Style="{DynamicResource SectionCardStyle}" Padding="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0"
                                                 Content="wiki.gg"
                                                 GroupName="WikiSelection"
                                                 IsChecked="{Binding IsWikiGgSelected}"
                                                 Style="{DynamicResource SegmentOptionStyle}"/>

                                    <RadioButton Grid.Column="1"
                                                 Content="Fextralife"
                                                 GroupName="WikiSelection"
                                                 IsChecked="{Binding IsFextralifeSelected}"
                                                 Style="{DynamicResource SegmentOptionStyle}"/>
                                </Grid>
                            </Border>

                            <ContentControl Content="{Binding Loc[Settings.Movement]}" Style="{DynamicResource SectionHeaderStyle}"/>

                            <Border Style="{DynamicResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Loc[Settings.SpeedMultiplier]}"
                                                   Style="{DynamicResource RowLabelStyle}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding MovementSpeedDisplay}"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Slider Minimum="1"
                                            Maximum="5"
                                            TickFrequency="0.1"
                                            SmallChange="0.1"
                                            LargeChange="0.5"
                                            Value="{Binding MovementSpeedMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                            IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </Border>

                            <ContentControl Content="{Binding Loc[Settings.Spawn]}" Style="{DynamicResource SectionHeaderStyle}"/>

                            <Border Style="{DynamicResource SectionCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Loc[Settings.DefaultStackSize]}"
                                               Style="{DynamicResource RowLabelStyle}"/>
                                    <TextBox Grid.Column="1"
                                             Width="90"
                                             Text="{Binding StackSize, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource SettingsTextBoxStyle}"/>
                                </Grid>
                            </Border>

                            <ContentControl Content="{Binding Loc[Settings.Language]}" Style="{DynamicResource SectionHeaderStyle}"/>

                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                      SelectedValuePath="Code"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding LanguageCode}"
                                      Style="{DynamicResource ModernComboBoxStyle}"/>

                            <ContentControl Content="{Binding Loc[Settings.Theme]}"
                                            Style="{DynamicResource SectionHeaderStyle}"
                                            Margin="0,20,0,10"/>

                            <Border Style="{DynamicResource SectionCardStyle}" Padding="4" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0"
                                                 Content="Classic"
                                                 GroupName="ThemeSelection"
                                                 IsChecked="{Binding IsClassicTheme}"
                                                 Style="{DynamicResource ThemeOptionStyle}"/>

                                    <RadioButton Grid.Column="1"
                                                 Content="Remnant"
                                                 GroupName="ThemeSelection"
                                                 IsChecked="{Binding IsRemnantTheme}"
                                                 Style="{DynamicResource ThemeOptionStyle}"/>
                                </Grid>
                            </Border>

                            <ContentControl Content="{Binding Loc[Settings.SettingsProfile]}"
                                       Style="{DynamicResource SectionHeaderStyle}"
                                       Margin="0,20,0,10"/>

                            <TextBlock Text="{Binding Loc[Settings.SettingsProfileTooltip]}"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Style="{DynamicResource DialogButtonStyle}" Grid.Column="0"
                                        Content="{Binding Loc[Settings.SaveSettings]}"
                                        Command="{Binding SaveSettingsProfileCommand}"
                                        FontSize="13"/>

                                <Button Style="{DynamicResource DialogButtonStyle}" Grid.Column="2"
                                        Content="{Binding Loc[Settings.LoadSettings]}"
                                        Command="{Binding LoadSettingsProfileCommand}"
                                        FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <!-- ================= Hotkeys ================= -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌨" FontSize="15" Width="22" TextAlignment="Center" Style="{DynamicResource NavTabIconStyle}"/>
                                <ContentControl Content="{Binding Loc[Settings.Hotkeys]}" Margin="8,0,0,0" Style="{DynamicResource TrackedLabelStyle}"/>
                            </StackPanel>
                        </TabItem.Header>

                        <StackPanel Margin="0,0,0,4">
                            <Border Style="{DynamicResource SectionCardStyle}">
                                <StackPanel>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Loc[Settings.ConsoleKey]}"
                                                   Style="{DynamicResource RowLabelStyle}"/>

                                        <Button Grid.Column="1"
                                                Style="{DynamicResource HotkeyButtonStyle}"
                                                Content="{Binding ConsoleKeyDisplay}"
                                                Command="{Binding StartConsoleKeyCaptureCommand}"
                                                PreviewKeyDown="ConsoleKeyButton_PreviewKeyDown"
                                                Focusable="True"/>
                                    </Grid>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Loc[Settings.Teleport]}"
                                                   Style="{DynamicResource RowLabelStyle}"/>

                                        <Button Grid.Column="1"
                                                Style="{DynamicResource HotkeyButtonStyle}"
                                                Content="{Binding TeleportHotkeyDisplay}"
                                                Command="{Binding StartTeleportHotkeyCaptureCommand}"
                                                PreviewKeyDown="TeleportHotkeyButton_PreviewKeyDown"
                                                PreviewMouseDown="TeleportHotkeyButton_PreviewMouseDown"
                                                Focusable="True"/>
                                    </Grid>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{DynamicResource RowLabelWithInfoStyle}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{DynamicResource InfoToolTipStyle}">
                                                    <TextBlock Text="{Binding Loc[Settings.DestroyTargetTooltip]}" Style="{DynamicResource InfoToolTipTextStyle}"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                            <Run Text="{Binding Loc[Settings.DestroyTarget], Mode=OneWay}"/>
                                            <Run Text=" ⓘ" Foreground="{DynamicResource WarnBrush}" FontWeight="Bold"/>
                                        </TextBlock>

                                        <Button Grid.Column="1"
                                                Style="{DynamicResource HotkeyButtonStyle}"
                                                Content="{Binding DestroyTargetHotkeyDisplay}"
                                                Command="{Binding StartDestroyTargetHotkeyCaptureCommand}"
                                                PreviewKeyDown="DestroyTargetHotkeyButton_PreviewKeyDown"
                                                PreviewMouseDown="DestroyTargetHotkeyButton_PreviewMouseDown"
                                                Focusable="True"/>
                                    </Grid>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{DynamicResource RowLabelWithInfoStyle}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{DynamicResource InfoToolTipStyle}">
                                                    <TextBlock Text="{Binding Loc[Settings.DestroyLastSpawnedTooltip]}" Style="{DynamicResource InfoToolTipTextStyle}"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                            <Run Text="{Binding Loc[Settings.DestroyLastSpawned], Mode=OneWay}"/>
                                            <Run Text=" ⓘ" Foreground="{DynamicResource WarnBrush}" FontWeight="Bold"/>
                                        </TextBlock>

                                        <Button Grid.Column="1"
                                                Style="{DynamicResource HotkeyButtonStyle}"
                                                Content="{Binding DestroyLastSpawnedHotkeyDisplay}"
                                                Command="{Binding StartDestroyLastSpawnedHotkeyCaptureCommand}"
                                                PreviewKeyDown="DestroyLastSpawnedHotkeyButton_PreviewKeyDown"
                                                PreviewMouseDown="DestroyLastSpawnedHotkeyButton_PreviewMouseDown"
                                                Focusable="True"/>
                                    </Grid>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{DynamicResource RowLabelWithInfoStyle}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{DynamicResource InfoToolTipStyle}">
                                                    <TextBlock Text="{Binding Loc[Settings.DestroyNearbySpawnedTooltip]}" Style="{DynamicResource InfoToolTipTextStyle}"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                            <Run Text="{Binding Loc[Settings.DestroyNearbySpawned], Mode=OneWay}"/>
                                            <Run Text=" ⓘ" Foreground="{DynamicResource WarnBrush}" FontWeight="Bold"/>
                                        </TextBlock>

                                        <Button Grid.Column="1"
                                                Style="{DynamicResource HotkeyButtonStyle}"
                                                Content="{Binding DestroyNearbySpawnedHotkeyDisplay}"
                                                Command="{Binding StartDestroyNearbySpawnedHotkeyCaptureCommand}"
                                                PreviewKeyDown="DestroyNearbySpawnedHotkeyButton_PreviewKeyDown"
                                                PreviewMouseDown="DestroyNearbySpawnedHotkeyButton_PreviewMouseDown"
                                                Focusable="True"/>
                                    </Grid>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Loc[Settings.ReplenishCooldowns]}"
                                                   Style="{DynamicResource RowLabelStyle}"/>

                                        <Button Grid.Column="1"
                                                Style="{DynamicResource HotkeyButtonStyle}"
                                                Content="{Binding ReplenishCooldownsHotkeyDisplay}"
                                                Command="{Binding StartReplenishCooldownsHotkeyCaptureCommand}"
                                                PreviewKeyDown="ReplenishCooldownsHotkeyButton_PreviewKeyDown"
                                                PreviewMouseDown="ReplenishCooldownsHotkeyButton_PreviewMouseDown"
                                                Focusable="True"/>
                                    </Grid>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{DynamicResource RowLabelWithInfoStyle}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{DynamicResource InfoToolTipStyle}">
                                                    <TextBlock Text="{Binding Loc[Settings.FastPlayerActionsTooltip]}" Style="{DynamicResource InfoToolTipTextStyle}"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                            <Run Text="{Binding Loc[Settings.FastPlayerActions], Mode=OneWay}"/>
                                            <Run Text=" ⓘ" Foreground="{DynamicResource WarnBrush}" FontWeight="Bold"/>
                                        </TextBlock>

                                        <Button Grid.Column="1"
                                                Style="{DynamicResource HotkeyButtonStyle}"
                                                Content="{Binding FastPlayerActionsHotkeyDisplay}"
                                                Command="{Binding StartFastPlayerActionsHotkeyCaptureCommand}"
                                                PreviewKeyDown="FastPlayerActionsHotkeyButton_PreviewKeyDown"
                                                PreviewMouseDown="FastPlayerActionsHotkeyButton_PreviewMouseDown"
                                                Focusable="True"/>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ================= Cheats ================= -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="15" Width="22" TextAlignment="Center" Style="{DynamicResource NavTabIconStyle}"/>
                                <ContentControl Content="{Binding Loc[Settings.Cheats]}" Margin="8,0,0,0" Style="{DynamicResource TrackedLabelStyle}"/>
                            </StackPanel>
                        </TabItem.Header>

                        <StackPanel Margin="0,0,0,4">
                            <Border Style="{DynamicResource SectionCardStyle}">
                                <StackPanel>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{DynamicResource RowLabelWithInfoStyle}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{DynamicResource InfoToolTipStyle}">
                                                    <TextBlock Text="{Binding Loc[Settings.InfiniteHealthTooltip]}" Style="{DynamicResource InfoToolTipTextStyle}"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                            <Run Text="{Binding Loc[Settings.InfiniteHealth], Mode=OneWay}"/>
                                            <Run Text=" ⓘ" Foreground="{DynamicResource WarnBrush}" FontWeight="Bold"/>
                                        </TextBlock>

                                        <ToggleButton Grid.Column="1" IsChecked="{Binding InfiniteHealth}" Style="{DynamicResource ModernToggleButtonStyle}"/>
                                    </Grid>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.InfiniteStamina]}" Style="{DynamicResource RowLabelStyle}"/>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding InfiniteStamina}" Style="{DynamicResource ModernToggleButtonStyle}"/>
                                    </Grid>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.InfiniteAmmo]}" Style="{DynamicResource RowLabelStyle}"/>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding InfiniteAmmo}" Style="{DynamicResource ModernToggleButtonStyle}"/>
                                    </Grid>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{DynamicResource RowLabelWithInfoStyle}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{DynamicResource InfoToolTipStyle}">
                                                    <TextBlock Text="{Binding Loc[Settings.NoFallDamageTooltip]}" Style="{DynamicResource InfoToolTipTextStyle}"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                            <Run Text="{Binding Loc[Settings.NoFallDamage], Mode=OneWay}"/>
                                            <Run Text=" ⓘ" Foreground="{DynamicResource WarnBrush}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding NoFallDamage}" Style="{DynamicResource ModernToggleButtonStyle}"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <ContentControl Content="{Binding Loc[Settings.Aim]}" Style="{DynamicResource SectionHeaderStyle}"/>

                            <Border Style="{DynamicResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.AimMagicBullets]}" Style="{DynamicResource RowLabelStyle}"/>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding AimMagicBulletsEnabled}" Style="{DynamicResource ModernToggleButtonStyle}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.AimFov]}" Style="{DynamicResource RowLabelStyle}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AimFovDisplay}"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Slider Minimum="0"
                                            Maximum="45"
                                            TickFrequency="1"
                                            SmallChange="1"
                                            LargeChange="5"
                                            Value="{Binding AimFov, UpdateSourceTrigger=PropertyChanged}"
                                            IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </Border>

                            <ContentControl Content="{Binding Loc[Settings.Loot]}" Style="{DynamicResource SectionHeaderStyle}"/>

                            <Border Style="{DynamicResource SectionCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.LootFullDropChance]}" Style="{DynamicResource RowLabelStyle}"/>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding LootFullDropChance}" Style="{DynamicResource ModernToggleButtonStyle}"/>
                                </Grid>
                            </Border>

                            <ContentControl Content="{Binding Loc[Settings.WeaponHandling]}" Style="{DynamicResource SectionHeaderStyle}"/>

                            <Border Style="{DynamicResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.NoRecoil]}" Style="{DynamicResource RowLabelStyle}"/>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding NoRecoil}" Style="{DynamicResource ModernToggleButtonStyle}"/>
                                    </Grid>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.NoSpread]}" Style="{DynamicResource RowLabelStyle}"/>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding NoSpread}" Style="{DynamicResource ModernToggleButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ================= Commands ================= -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☰" FontSize="15" Width="22" TextAlignment="Center" Style="{DynamicResource NavTabIconStyle}"/>
                                <ContentControl Content="{Binding Loc[Settings.CheatCommands]}" Margin="8,0,0,0" Style="{DynamicResource TrackedLabelStyle}"/>
                            </StackPanel>
                        </TabItem.Header>

                        <StackPanel Margin="0,0,0,4">
                            <Border Style="{DynamicResource SectionCardStyle}">
                                <StackPanel>

                                    <!-- Level Up: not currently reliable in-game (see chat history),
                                         hidden from the UI but the command/binding stay wired up. -->
                                    <Grid Style="{DynamicResource RowGridStyle}" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="84"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.LevelUp]}" Style="{DynamicResource RowLabelStyle}"/>
                                        <TextBox Grid.Column="1" Text="{Binding LevelUpCount, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource SettingsTextBoxStyle}"/>
                                        <Button Style="{DynamicResource DialogButtonStyle}" Grid.Column="3" Content="{Binding Loc[Settings.Send]}" Command="{Binding LevelUpCommand}" Height="34" FontSize="12"/>
                                    </Grid>

                                    <!-- Set All Weapon Level -->
                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="84"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{DynamicResource RowLabelWithInfoStyle}">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{DynamicResource InfoToolTipStyle}">
                                                    <TextBlock Text="{Binding Loc[Settings.SetAllWeaponLevelTooltip]}" Style="{DynamicResource InfoToolTipTextStyle}"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                            <Run Text="{Binding Loc[Settings.SetAllWeaponLevel], Mode=OneWay}"/>
                                            <Run Text=" ⓘ" Foreground="{DynamicResource WarnBrush}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBox Grid.Column="1" Text="{Binding SetWeaponLevelValue, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource SettingsTextBoxStyle}"/>
                                        <Button Style="{DynamicResource DialogButtonStyle}" Grid.Column="3" Content="{Binding Loc[Settings.Send]}" Command="{Binding SetAllWeaponLevelCommand}" Height="34" FontSize="12"/>
                                    </Grid>

                                    <Border Style="{DynamicResource CardDividerStyle}"/>

                                    <!-- Set Inventory Item Quantity -->
                                    <TextBlock Text="{Binding Loc[Settings.SetInventoryItemQuantity]}"
                                               Foreground="{DynamicResource TextDimBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <Grid Style="{DynamicResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="84"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding InventoryItems}"
                                                  SelectedValuePath="Name"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValue="{Binding InventoryItemName, Mode=TwoWay}"
                                                  Style="{DynamicResource ModernComboBoxStyle}"
                                                  FontSize="12"/>

                                        <TextBox Grid.Column="2" Text="{Binding InventoryItemQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource SettingsTextBoxStyle}"/>
                                        <Button Style="{DynamicResource DialogButtonStyle}" Grid.Column="4" Content="{Binding Loc[Settings.Send]}" Command="{Binding SetInventoryItemQuantityCommand}" Height="34" FontSize="12"/>
                                    </Grid>

                                    <TextBlock Text="{Binding InventoryItemName}"
                                               Foreground="{DynamicResource TextFaintBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,8"/>

                                    <Border Style="{DynamicResource CardDividerStyle}"/>

                                    <!-- Log Inventory Items. Only "current items" logging is exposed in the
                                         UI; the all-items switch stays wired (default false) so the binding
                                         doesn't need to be ripped out if it comes back later. -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Content="{Binding Loc[Settings.LogAllItems]}"
                                                  IsChecked="{Binding LogAllInventoryItems}"
                                                  Style="{DynamicResource ModernCheckBoxStyle}"
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed"/>

                                        <Button Style="{DynamicResource DialogButtonStyle}" Grid.Column="1" Content="{Binding Loc[Settings.LogInventoryItems]}" Command="{Binding LogInventoryItemsCommand}" Height="34" Padding="14,0" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ================= Weapon Mods ================= -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚔" FontSize="15" Width="22" TextAlignment="Center" Style="{DynamicResource NavTabIconStyle}"/>
                                <ContentControl Content="{Binding Loc[Settings.BoostWeaponMods]}" Margin="8,0,0,0" Style="{DynamicResource TrackedLabelStyle}"/>
                            </StackPanel>
                        </TabItem.Header>

                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Loc[Settings.BoostWeaponModsTooltip]}"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>

                            <Button Content="{Binding Loc[Settings.ApplyAll]}"
                                    Command="{Binding ApplyAllWeaponModBoostsCommand}"
                                    Style="{DynamicResource PrimaryDialogButtonStyle}"
                                    Height="38"
                                    FontSize="13"
                                    Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding WeaponModBoostGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:MasonryPanel ColumnWidth="350" ColumnSpacing="12" RowSpacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Style="{DynamicResource WeaponModExpanderStyle}"
                                                  IsExpanded="{Binding IsExpanded}"
                                                  Width="350">
                                            <Expander.Header>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Fields.Count, StringFormat={}{0} values}"
                                                               Foreground="{DynamicResource TextFaintBrush}"
                                                               FontSize="10"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Expander.Header>

                                            <StackPanel>
                                                <Border Height="1" Background="{DynamicResource SubtleDividerBrush}" Margin="0,0,0,10"/>

                                                <ItemsControl ItemsSource="{Binding Fields}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{DynamicResource FieldCellStyle}"
                                                                    Width="155"
                                                                    Margin="0,0,8,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Key}"
                                                                               Foreground="{DynamicResource TextFaintBrush}"
                                                                               FontSize="10"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,0,0,4"/>

                                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{DynamicResource SettingsTextBoxStyle}"
                                                                             Height="28"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Style="{DynamicResource DialogButtonStyle}" Content="{Binding DataContext.Loc[Settings.Send], RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding ApplyCommand}"
                                                        Height="30"
                                                        FontSize="11"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
