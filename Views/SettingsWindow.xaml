<Window x:Class="Remnant2UnlockerApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Remnant2UnlockerApp.Controls"
        Title="Settings"
        Width="1050"
        Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101116">

    <Window.Resources>

        <!-- ============ Base controls ============ -->

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#252936"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33405F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1F2D4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hotkey capture buttons need extra room + wrapping so long values (e.g. "MiddleMouseButton")
             never get clipped or crowd neighbouring content. -->
        <Style x:Key="HotkeyButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style x:Key="ModernToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="52"
                                Height="28"
                                CornerRadius="14"
                                Background="#252936"
                                BorderBrush="#33405F"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="20"
                                     Height="20"
                                     Fill="#8F95A3"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8DCE5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="#252936"
                                    BorderBrush="#33405F"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Data="M 3 7 L 6 10 L 11 3"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#33405F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ============ Layout helpers ============ -->

        <!-- Compact tile used by the Weapon Mods grid: same dark chevron-header look as
             MainWindow.xaml's ProfessionalExpanderStyle, but instances get a fixed Width and are
             laid out by MasonryPanel below (which owns all tile spacing) so mods of different
             heights pack tightly instead of leaving gaps, plus a fade transition on expand/collapse. -->
        <Style x:Key="WeaponModExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="Outer"
                                Background="#171922"
                                BorderBrush="#273044"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ToggleButton x:Name="HeaderSite"
                                              Grid.Row="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              Padding="10,9">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderRoot"
                                                    Background="Transparent"
                                                    CornerRadius="12"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border x:Name="ChevronCircle"
                                                            Grid.Column="0"
                                                            Width="16"
                                                            Height="16"
                                                            CornerRadius="8"
                                                            Background="#2F3A56"
                                                            VerticalAlignment="Center">
                                                        <Path x:Name="Chevron"
                                                              Data="M 4 6 L 8.5 10.5 L 13 6"
                                                              Stroke="#D8DCE5"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>

                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="8,0,0,0"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderRoot" Property="Background" Value="#1D2231"/>
                                                    <Setter TargetName="ChevronCircle" Property="Background" Value="#33405F"/>
                                                </Trigger>

                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="HeaderRoot" Property="Background" Value="#1A1D27"/>
                                                    <Setter TargetName="ChevronCircle" Property="Background" Value="#3B82F6"/>
                                                    <Setter TargetName="Chevron" Property="Stroke" Value="#FFFFFF"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                                 Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                 To="180" Duration="0:0:0.16"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                                 Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                 To="0" Duration="0:0:0.16"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>

                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      VerticalAlignment="Center"/>
                                </ToggleButton>

                                <Border x:Name="ContentHost"
                                        Grid.Row="1"
                                        Padding="10,2,10,10"
                                        Visibility="Collapsed"
                                        Opacity="0">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#171922"/>
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#273044"/>
                                <Setter TargetName="Outer" Property="CornerRadius" Value="12"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" Duration="0:0:0.14"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.14" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E212B"/>
            <Setter Property="BorderBrush" Value="#33405F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8F95A3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Every settings row: label on the left (wraps instead of overlapping the control when a
             translation runs long), control fixed on the right with a guaranteed gap between them. -->
        <Style x:Key="RowGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8DCE5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="CardDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#303645"/>
            <Setter Property="Margin" Value="0,4,0,16"/>
        </Style>

        <!-- Shared "ⓘ" tooltip chrome: usages just set Content to the localized tooltip text. -->
        <Style x:Key="InfoToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#1A1D27"
                                BorderBrush="#33405F"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoToolTipTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- A row label that also carries an info tooltip, rendered as one wrappable TextBlock so the
             "ⓘ" glyph can never be pushed off past a fixed-width neighbour. -->
        <Style x:Key="RowLabelWithInfoStyle" TargetType="TextBlock" BasedOn="{StaticResource RowLabelStyle}">
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
        </Style>

        <!-- ============ ComboBox ============ -->

        <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252936"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#33405F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1D27"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#33405F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#8F95A3"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#60A5FA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.Background>
                                <ToggleButton.BorderBrush>
                                    <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.BorderBrush>
                                <ToggleButton.BorderThickness>
                                    <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.BorderThickness>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                               IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                               Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        Background="#1A1D27"
                                        BorderBrush="#33405F"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="12" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Left navigation (TabControl repurposed as a sidebar) ============ -->

        <Style x:Key="NavTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="196"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#171922"
                                    BorderBrush="#252936"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8">
                                <StackPanel x:Name="HeaderPanel"
                                            IsItemsHost="True"
                                            Orientation="Vertical"/>
                            </Border>

                            <ScrollViewer Grid.Column="2"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,0,4,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8F95A3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                CornerRadius="9"
                                Padding="12,11"
                                Margin="0,0,0,4"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#232838"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="18"
            Padding="18"
            Background="#1A1D27"
            BorderBrush="#33405F"
            BorderThickness="1"
            CornerRadius="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding Loc[Settings.Title]}"
                       Foreground="#F2F2F2"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,18"/>

            <TabControl Grid.Row="1"
                        Style="{StaticResource NavTabControlStyle}"
                        ItemContainerStyle="{StaticResource NavTabItemStyle}">

                <!-- ================= General ================= -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Settings.TabGeneral]}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>

                    <StackPanel Margin="0,0,0,4">

                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Loc[Settings.AlwaysOnTop]}"
                                           Style="{StaticResource RowLabelStyle}"/>

                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding AlwaysOnTop}"
                                              Style="{StaticResource ModernToggleButtonStyle}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Loc[Settings.Wiki]}" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SectionCardStyle}" Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0"
                                             Content="wiki.gg"
                                             GroupName="WikiSelection"
                                             IsChecked="{Binding IsWikiGgSelected}"
                                             Cursor="Hand"
                                             Foreground="#F2F2F2"
                                             FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Root"
                                                    Height="34"
                                                    CornerRadius="9"
                                                    Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#33405F"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>

                                <RadioButton Grid.Column="1"
                                             Content="Fextralife"
                                             GroupName="WikiSelection"
                                             IsChecked="{Binding IsFextralifeSelected}"
                                             Cursor="Hand"
                                             Foreground="#F2F2F2"
                                             FontWeight="SemiBold"
                                             HorizontalContentAlignment="Center">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Root"
                                                    Height="34"
                                                    CornerRadius="9"
                                                    Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#33405F"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Loc[Settings.Movement]}" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Loc[Settings.SpeedMultiplier]}"
                                               Style="{StaticResource RowLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MovementSpeedDisplay}"
                                               Foreground="#60A5FA"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Slider Minimum="1"
                                        Maximum="5"
                                        TickFrequency="0.1"
                                        SmallChange="0.1"
                                        LargeChange="0.5"
                                        Value="{Binding MovementSpeedMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                        IsSnapToTickEnabled="True"/>
                            </StackPanel>
                        </Border>

                        <!-- FOV cheat is currently non-functional in-game; hidden from the UI until it
                             works, but the binding/slider stay wired up so re-enabling is a one-line
                             Visibility flip instead of rebuilding this section. -->
                        <StackPanel Visibility="Collapsed">
                            <TextBlock Text="{Binding Loc[Settings.Fov]}" Style="{StaticResource SectionHeaderStyle}"/>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Loc[Settings.Fov]}"
                                                   Style="{StaticResource RowLabelStyle}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FovDisplay}"
                                                   Foreground="#60A5FA"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Slider Minimum="60"
                                            Maximum="120"
                                            TickFrequency="1"
                                            SmallChange="1"
                                            LargeChange="5"
                                            Value="{Binding FovValue, UpdateSourceTrigger=PropertyChanged}"
                                            IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Loc[Settings.Spawn]}" Style="{StaticResource SectionHeaderStyle}"/>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Loc[Settings.DefaultStackSize]}"
                                           Style="{StaticResource RowLabelStyle}"/>
                                <TextBox Grid.Column="1"
                                         Width="90"
                                         Text="{Binding StackSize, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBoxStyle}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Loc[Settings.Language]}" Style="{StaticResource SectionHeaderStyle}"/>

                        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                  SelectedValuePath="Code"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding LanguageCode}"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>
                </TabItem>

                <!-- ================= Hotkeys ================= -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨" FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Settings.Hotkeys]}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>

                    <StackPanel Margin="0,0,0,4">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Loc[Settings.ConsoleKey]}"
                                               Style="{StaticResource RowLabelStyle}"/>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource HotkeyButtonStyle}"
                                            Content="{Binding ConsoleKeyDisplay}"
                                            Command="{Binding StartConsoleKeyCaptureCommand}"
                                            PreviewKeyDown="ConsoleKeyButton_PreviewKeyDown"
                                            Focusable="True"/>
                                </Grid>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Loc[Settings.Teleport]}"
                                               Style="{StaticResource RowLabelStyle}"/>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource HotkeyButtonStyle}"
                                            Content="{Binding TeleportHotkeyDisplay}"
                                            Command="{Binding StartTeleportHotkeyCaptureCommand}"
                                            PreviewKeyDown="TeleportHotkeyButton_PreviewKeyDown"
                                            PreviewMouseDown="TeleportHotkeyButton_PreviewMouseDown"
                                            Focusable="True"/>
                                </Grid>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabelWithInfoStyle}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                                <TextBlock Text="{Binding Loc[Settings.DestroyTargetTooltip]}" Style="{StaticResource InfoToolTipTextStyle}"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                        <Run Text="{Binding Loc[Settings.DestroyTarget], Mode=OneWay}"/>
                                        <Run Text=" ⓘ" Foreground="#FACC15" FontWeight="Bold"/>
                                    </TextBlock>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource HotkeyButtonStyle}"
                                            Content="{Binding DestroyTargetHotkeyDisplay}"
                                            Command="{Binding StartDestroyTargetHotkeyCaptureCommand}"
                                            PreviewKeyDown="DestroyTargetHotkeyButton_PreviewKeyDown"
                                            PreviewMouseDown="DestroyTargetHotkeyButton_PreviewMouseDown"
                                            Focusable="True"/>
                                </Grid>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabelWithInfoStyle}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                                <TextBlock Text="{Binding Loc[Settings.DestroyLastSpawnedTooltip]}" Style="{StaticResource InfoToolTipTextStyle}"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                        <Run Text="{Binding Loc[Settings.DestroyLastSpawned], Mode=OneWay}"/>
                                        <Run Text=" ⓘ" Foreground="#FACC15" FontWeight="Bold"/>
                                    </TextBlock>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource HotkeyButtonStyle}"
                                            Content="{Binding DestroyLastSpawnedHotkeyDisplay}"
                                            Command="{Binding StartDestroyLastSpawnedHotkeyCaptureCommand}"
                                            PreviewKeyDown="DestroyLastSpawnedHotkeyButton_PreviewKeyDown"
                                            PreviewMouseDown="DestroyLastSpawnedHotkeyButton_PreviewMouseDown"
                                            Focusable="True"/>
                                </Grid>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabelWithInfoStyle}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                                <TextBlock Text="{Binding Loc[Settings.DestroyNearbySpawnedTooltip]}" Style="{StaticResource InfoToolTipTextStyle}"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                        <Run Text="{Binding Loc[Settings.DestroyNearbySpawned], Mode=OneWay}"/>
                                        <Run Text=" ⓘ" Foreground="#FACC15" FontWeight="Bold"/>
                                    </TextBlock>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource HotkeyButtonStyle}"
                                            Content="{Binding DestroyNearbySpawnedHotkeyDisplay}"
                                            Command="{Binding StartDestroyNearbySpawnedHotkeyCaptureCommand}"
                                            PreviewKeyDown="DestroyNearbySpawnedHotkeyButton_PreviewKeyDown"
                                            PreviewMouseDown="DestroyNearbySpawnedHotkeyButton_PreviewMouseDown"
                                            Focusable="True"/>
                                </Grid>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Loc[Settings.ReplenishCooldowns]}"
                                               Style="{StaticResource RowLabelStyle}"/>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource HotkeyButtonStyle}"
                                            Content="{Binding ReplenishCooldownsHotkeyDisplay}"
                                            Command="{Binding StartReplenishCooldownsHotkeyCaptureCommand}"
                                            PreviewKeyDown="ReplenishCooldownsHotkeyButton_PreviewKeyDown"
                                            PreviewMouseDown="ReplenishCooldownsHotkeyButton_PreviewMouseDown"
                                            Focusable="True"/>
                                </Grid>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabelWithInfoStyle}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                                <TextBlock Text="{Binding Loc[Settings.FastPlayerActionsTooltip]}" Style="{StaticResource InfoToolTipTextStyle}"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                        <Run Text="{Binding Loc[Settings.FastPlayerActions], Mode=OneWay}"/>
                                        <Run Text=" ⓘ" Foreground="#FACC15" FontWeight="Bold"/>
                                    </TextBlock>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource HotkeyButtonStyle}"
                                            Content="{Binding FastPlayerActionsHotkeyDisplay}"
                                            Command="{Binding StartFastPlayerActionsHotkeyCaptureCommand}"
                                            PreviewKeyDown="FastPlayerActionsHotkeyButton_PreviewKeyDown"
                                            PreviewMouseDown="FastPlayerActionsHotkeyButton_PreviewMouseDown"
                                            Focusable="True"/>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ================= Cheats ================= -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Settings.Cheats]}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>

                    <StackPanel Margin="0,0,0,4">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabelWithInfoStyle}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                                <TextBlock Text="{Binding Loc[Settings.InfiniteHealthTooltip]}" Style="{StaticResource InfoToolTipTextStyle}"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                        <Run Text="{Binding Loc[Settings.InfiniteHealth], Mode=OneWay}"/>
                                        <Run Text=" ⓘ" Foreground="#FACC15" FontWeight="Bold"/>
                                    </TextBlock>

                                    <ToggleButton Grid.Column="1" IsChecked="{Binding InfiniteHealth}" Style="{StaticResource ModernToggleButtonStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.InfiniteStamina]}" Style="{StaticResource RowLabelStyle}"/>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding InfiniteStamina}" Style="{StaticResource ModernToggleButtonStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.InfiniteAmmo]}" Style="{StaticResource RowLabelStyle}"/>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding InfiniteAmmo}" Style="{StaticResource ModernToggleButtonStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabelWithInfoStyle}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                                <TextBlock Text="{Binding Loc[Settings.NoFallDamageTooltip]}" Style="{StaticResource InfoToolTipTextStyle}"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                        <Run Text="{Binding Loc[Settings.NoFallDamage], Mode=OneWay}"/>
                                        <Run Text=" ⓘ" Foreground="#FACC15" FontWeight="Bold"/>
                                    </TextBlock>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding NoFallDamage}" Style="{StaticResource ModernToggleButtonStyle}"/>
                                </Grid>

                                <!-- Enemy ESP is more theorycraft than working feature right now (custom-depth
                                     rendering approach is unproven); hidden from the UI but the binding stays
                                     wired up so re-enabling is a one-line Visibility flip. -->
                                <Grid Margin="0,0,0,4" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabelWithInfoStyle}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                                <TextBlock Text="{Binding Loc[Settings.EnemyEspTooltip]}" Style="{StaticResource InfoToolTipTextStyle}"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                        <Run Text="{Binding Loc[Settings.EnemyEsp], Mode=OneWay}"/>
                                        <Run Text=" ⓘ" Foreground="#FACC15" FontWeight="Bold"/>
                                    </TextBlock>

                                    <ToggleButton Grid.Column="1" IsChecked="{Binding EnemyEsp}" Style="{StaticResource ModernToggleButtonStyle}"/>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ================= Commands ================= -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☰" FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Settings.CheatCommands]}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>

                    <StackPanel Margin="0,0,0,4">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>

                                <!-- Level Up: not currently reliable in-game (see chat history),
                                     hidden from the UI but the command/binding stay wired up. -->
                                <Grid Style="{StaticResource RowGridStyle}" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="84"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Settings.LevelUp]}" Style="{StaticResource RowLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding LevelUpCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                                    <Button Grid.Column="3" Content="{Binding Loc[Settings.Send]}" Command="{Binding LevelUpCommand}" Height="34" FontSize="12"/>
                                </Grid>

                                <!-- Set All Weapon Level -->
                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="84"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabelWithInfoStyle}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                                <TextBlock Text="{Binding Loc[Settings.SetAllWeaponLevelTooltip]}" Style="{StaticResource InfoToolTipTextStyle}"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                        <Run Text="{Binding Loc[Settings.SetAllWeaponLevel], Mode=OneWay}"/>
                                        <Run Text=" ⓘ" Foreground="#FACC15" FontWeight="Bold"/>
                                    </TextBlock>
                                    <TextBox Grid.Column="1" Text="{Binding SetWeaponLevelValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                                    <Button Grid.Column="3" Content="{Binding Loc[Settings.Send]}" Command="{Binding SetAllWeaponLevelCommand}" Height="34" FontSize="12"/>
                                </Grid>

                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- Set Inventory Item Quantity -->
                                <TextBlock Text="{Binding Loc[Settings.SetInventoryItemQuantity]}"
                                           Foreground="#D8DCE5"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <Grid Style="{StaticResource RowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="84"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding InventoryItems}"
                                              SelectedValuePath="Name"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValue="{Binding InventoryItemName, Mode=TwoWay}"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              FontSize="12"/>

                                    <TextBox Grid.Column="2" Text="{Binding InventoryItemQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                                    <Button Grid.Column="4" Content="{Binding Loc[Settings.Send]}" Command="{Binding SetInventoryItemQuantityCommand}" Height="34" FontSize="12"/>
                                </Grid>

                                <TextBlock Text="{Binding InventoryItemName}"
                                           Foreground="#8F95A3"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8"/>

                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- Log Inventory Items. Only "current items" logging is exposed in the
                                     UI; the all-items switch stays wired (default false) so the binding
                                     doesn't need to be ripped out if it comes back later. -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Content="{Binding Loc[Settings.LogAllItems]}"
                                              IsChecked="{Binding LogAllInventoryItems}"
                                              Style="{StaticResource ModernCheckBoxStyle}"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"/>

                                    <Button Grid.Column="1" Content="{Binding Loc[Settings.LogInventoryItems]}" Command="{Binding LogInventoryItemsCommand}" Height="34" Padding="14,0" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ================= Weapon Mods ================= -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚔" FontSize="15" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Settings.BoostWeaponMods]}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </TabItem.Header>

                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="{Binding Loc[Settings.BoostWeaponModsTooltip]}"
                                   Foreground="#8F95A3"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <Button Content="{Binding Loc[Settings.ApplyAll]}"
                                Command="{Binding ApplyAllWeaponModBoostsCommand}"
                                Background="#2563EB"
                                Height="38"
                                FontSize="13"
                                Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding WeaponModBoostGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:MasonryPanel ColumnWidth="350" ColumnSpacing="12" RowSpacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Style="{StaticResource WeaponModExpanderStyle}"
                                              IsExpanded="{Binding IsExpanded}"
                                              Width="350">
                                        <Expander.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="#F2F2F2"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Fields.Count, StringFormat={}{0} values}"
                                                           Foreground="#8F95A3"
                                                           FontSize="10"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Expander.Header>

                                        <StackPanel>
                                            <Border Height="1" Background="#242837" Margin="0,0,0,10"/>

                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1A1D27"
                                                                BorderBrush="#2A2E3C"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="8,6"
                                                                Width="155"
                                                                Margin="0,0,8,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Key}"
                                                                           Foreground="#8F95A3"
                                                                           FontSize="10"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,0,0,4"/>

                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource SettingsTextBoxStyle}"
                                                                         Height="28"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="{Binding DataContext.Loc[Settings.Send], RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding ApplyCommand}"
                                                    Height="30"
                                                    FontSize="11"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>
