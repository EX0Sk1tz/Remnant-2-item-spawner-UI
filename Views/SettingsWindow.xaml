<Window x:Class="Remnant2UnlockerApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="620"
        Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101116">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#252936"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33405F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1F2D4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="52"
                                Height="28"
                                CornerRadius="14"
                                Background="#252936"
                                BorderBrush="#33405F"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="20"
                                     Height="20"
                                     Fill="#8F95A3"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Padding="18"
            Background="#1A1D27"
            BorderBrush="#33405F"
            BorderThickness="1"
            CornerRadius="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Settings"
                       Foreground="#F2F2F2"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,18"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Always on top"
                                   Foreground="#D8DCE5"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>

                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding AlwaysOnTop}"
                                      Style="{StaticResource ModernToggleButtonStyle}"/>
                    </Grid>

                    <TextBlock Text="Wiki"
                               Foreground="#8F95A3"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <Border Background="#252936"
                            BorderBrush="#33405F"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="4"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0"
                                         Content="wiki.gg"
                                         GroupName="WikiSelection"
                                         IsChecked="{Binding IsWikiGgSelected}"
                                         Cursor="Hand"
                                         Foreground="#F2F2F2"
                                         FontWeight="SemiBold"
                                         HorizontalContentAlignment="Center">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Root"
                                                Height="34"
                                                CornerRadius="9"
                                                Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#33405F"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <RadioButton Grid.Column="1"
                                         Content="Fextralife"
                                         GroupName="WikiSelection"
                                         IsChecked="{Binding IsFextralifeSelected}"
                                         Cursor="Hand"
                                         Foreground="#F2F2F2"
                                         FontWeight="SemiBold"
                                         HorizontalContentAlignment="Center">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Root"
                                                Height="34"
                                                CornerRadius="9"
                                                Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#33405F"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Root" Property="Background" Value="#2563EB"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <TextBlock Text="Movement"
                               Foreground="#8F95A3"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <Border Background="#252936"
                            BorderBrush="#33405F"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,20">

                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Speed multiplier"
                                           Foreground="#D8DCE5"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding MovementSpeedDisplay}"
                                           Foreground="#60A5FA"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Slider Minimum="1"
                                    Maximum="5"
                                    TickFrequency="0.1"
                                    SmallChange="0.1"
                                    LargeChange="0.5"
                                    Value="{Binding MovementSpeedMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                    IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Spawn"
                       Foreground="#8F95A3"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <Border Background="#252936"
                        BorderBrush="#33405F"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,20">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Default stack size"
                                Foreground="#D8DCE5"
                                FontSize="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                       />
                            <TextBox Grid.Column="1"
                                 Text="{Binding StackSize, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Background="#1A1D27"
                                 Foreground="#F2F2F2"
                                 BorderBrush="#33405F"
                                 BorderThickness="1"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Diagnostics"
                       Foreground="#8F95A3"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <Button Content="Open Setup Diagnostics"
                            Click="OpenDiagnostics_Click"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Background="#303645"
                        HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hotkeys"
                               Foreground="#8F95A3"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Console key"
                                   Foreground="#D8DCE5"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="{Binding ConsoleKeyDisplay}"
                                Command="{Binding StartConsoleKeyCaptureCommand}"
                                PreviewKeyDown="ConsoleKeyButton_PreviewKeyDown"
                                Focusable="True"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Teleport"
                                   Foreground="#D8DCE5"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="{Binding TeleportHotkeyDisplay}"
                                Command="{Binding StartTeleportHotkeyCaptureCommand}"
                                PreviewKeyDown="TeleportHotkeyButton_PreviewKeyDown"
                                PreviewMouseDown="TeleportHotkeyButton_PreviewMouseDown"
                                Focusable="True"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            ToolTipService.InitialShowDelay="250"
                            ToolTipService.ShowDuration="12000">

                            <StackPanel.ToolTip>
                                <ToolTip Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     HasDropShadow="True">
                                    <Border Background="#1A1D27"
                                        BorderBrush="#33405F"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        MaxWidth="280">
                                    <TextBlock Text="Deletes the object you are currently looking at. This can remove world objects, invisible barriers, or important level parts. Use carefully."
                                       Foreground="#F2F2F2"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                                    </Border>
                                </ToolTip>
                            </StackPanel.ToolTip>

                            <TextBlock Text="DestroyTarget"
                               Foreground="#D8DCE5"
                               FontSize="14"
                               VerticalAlignment="Center"/>

                            <TextBlock Text="  ⓘ"
                               Foreground="#FACC15"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                            Content="{Binding DestroyTargetHotkeyDisplay}"
                            Command="{Binding StartDestroyTargetHotkeyCaptureCommand}"
                            PreviewKeyDown="DestroyTargetHotkeyButton_PreviewKeyDown"
                            PreviewMouseDown="DestroyTargetHotkeyButton_PreviewMouseDown"
                            Focusable="True"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>