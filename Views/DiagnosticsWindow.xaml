<Window x:Class="Remnant2UnlockerApp.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup Diagnostics"
        Width="860"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFont}">

    <Grid>
        <!-- Background layers (transparent in themes that don't use them) -->
        <Rectangle Fill="{DynamicResource Grain}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource SkyGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource FireGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource Vignette}" IsHitTestVisible="False"/>

        <Border Margin="18"
                Padding="18"
                Style="{DynamicResource DialogPanelStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Setup Diagnostics"
                                   Style="{DynamicResource LargePageTitleStyle}"/>

                        <TextBlock Text="{Binding DiagnosticReport.Summary}"
                                   Foreground="{DynamicResource TextFaintBrush}"
                                   FontSize="13"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Run Checks"
                            Click="RunChecks_Click"
                            Style="{DynamicResource PrimaryChipButtonStyle}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Top"/>

                    <Button Grid.Column="2"
                            Content="Copy Report"
                            Click="CopyReport_Click"
                            Style="{DynamicResource ChipButtonStyle}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Top"
                            ToolTip="Copies the full diagnostics report to your clipboard — paste it when asking for help"/>

                    <Button Grid.Column="3"
                            Content="Open Folder"
                            Click="OpenFolder_Click"
                            Style="{DynamicResource ChipButtonStyle}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Top"/>

                    <Border Grid.Column="4"
                            Style="{DynamicResource InfoPanelStyle}"
                            Padding="12,8"
                            VerticalAlignment="Top">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Need help? "
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>

                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://discord.com/users/237621116632301570"
                                           RequestNavigate="DiscordLink_RequestNavigate">
                                    <Run Text="Discord"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="ResultsItemsControl"
                                  ItemsSource="{Binding DiagnosticReport.Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card"
                                        Style="{DynamicResource DiagnosticsCardStyle}">

                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"/>

                                            <Border x:Name="Badge"
                                                    Grid.Column="1"
                                                    Style="{DynamicResource StatusBadgeStyle}"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock x:Name="BadgeText"
                                                           Text="ISSUE"
                                                           Foreground="{DynamicResource ErrorTextBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Details}"
                                                   Foreground="{DynamicResource TextDimBrush}"
                                                   FontSize="13"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"/>

                                        <StackPanel x:Name="FixPanel">
                                            <TextBlock Text="How to fix"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,14,0,4"/>

                                            <TextBlock Text="{Binding Fix}"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <TextBlock Text="Technical details"
                                                   Foreground="{DynamicResource TextFaintBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,14,0,4"/>

                                        <TextBlock Text="{Binding TechnicalDetails}"
                                                   Foreground="{DynamicResource TextFaintBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Info">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DiagInfoBorderBrush}"/>
                                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource InfoSurfaceBrush}"/>
                                        <Setter TargetName="BadgeText" Property="Text" Value="INFO"/>
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource InfoTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Passed">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DiagPassBorderBrush}"/>
                                        <Setter TargetName="Card" Property="Padding" Value="14,10"/>
                                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SuccessSurfaceBrush}"/>
                                        <Setter TargetName="BadgeText" Property="Text" Value="PASS"/>
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                        <Setter TargetName="FixPanel" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
