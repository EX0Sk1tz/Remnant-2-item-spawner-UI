<Window x:Class="Remnant2UnlockerApp.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup Diagnostics"
        Width="720"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101116">

    <Border Margin="18"
            Padding="18"
            Background="#1A1D27"
            BorderBrush="#33405F"
            BorderThickness="1"
            CornerRadius="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Setup Diagnostics"
                   Foreground="#F2F2F2"
                   FontSize="22"
                   FontWeight="Bold"/>

                    <TextBlock Text="{Binding Summary}"
                   Foreground="#8F95A3"
                   FontSize="13"
                   Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                    Background="#252936"
                    BorderBrush="#33405F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,8"
                    VerticalAlignment="Top">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Need help? "
                           Foreground="#8F95A3"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                        <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center">
                <Hyperlink NavigateUri="https://discord.com/users/237621116632301570"
                           RequestNavigate="DiscordLink_RequestNavigate">
                    <Run Text="Discord"/>
                </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252936"
                                    BorderBrush="#33405F"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,0,12">

                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#F2F2F2"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Details}"
                                               Foreground="#D8DCE5"
                                               FontSize="13"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="How to fix"
                                               Foreground="#60A5FA"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="0,14,0,4"/>

                                    <TextBlock Text="{Binding Fix}"
                                               Foreground="#D8DCE5"
                                               FontSize="13"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Technical details"
                                               Foreground="#8F95A3"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="0,14,0,4"/>

                                    <TextBlock Text="{Binding TechnicalDetails}"
                                               Foreground="#8F95A3"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>