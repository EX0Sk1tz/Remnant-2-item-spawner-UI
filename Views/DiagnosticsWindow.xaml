<Window x:Class="Remnant2UnlockerApp.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup Diagnostics"
        Width="720"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101116">

    <Border Margin="18"
            Padding="18"
            Background="#1A1D27"
            BorderBrush="#33405F"
            BorderThickness="1"
            CornerRadius="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Setup Diagnostics"
                   Foreground="#F2F2F2"
                   FontSize="22"
                   FontWeight="Bold"/>

                    <TextBlock Text="{Binding DiagnosticReport.Summary}"
                   Foreground="#8F95A3"
                   FontSize="13"
                   Margin="0,6,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Run Checks"
                        Click="RunChecks_Click"
                        Style="{StaticResource ChipButtonStyle}"
                        Background="#2563EB"
                        BorderBrush="#2563EB"
                        Foreground="#FFFFFF"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top"/>

                <Button Grid.Column="2"
                        Content="Open Folder"
                        Click="OpenFolder_Click"
                        Style="{StaticResource ChipButtonStyle}"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top"/>

                <Border Grid.Column="3"
                    Background="#252936"
                    BorderBrush="#33405F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,8"
                    VerticalAlignment="Top">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Need help? "
                           Foreground="#8F95A3"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                        <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center">
                <Hyperlink NavigateUri="https://discord.com/users/237621116632301570"
                           RequestNavigate="DiscordLink_RequestNavigate">
                    <Run Text="Discord"/>
                </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="ResultsItemsControl"
                              ItemsSource="{Binding DiagnosticReport.Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card"
                                    Background="#252936"
                                    BorderBrush="#33405F"
                                    BorderThickness="1,1,1,1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,0,10">

                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   Foreground="#F2F2F2"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"/>

                                        <Border x:Name="Badge"
                                                Grid.Column="1"
                                                Background="#7F1D1D"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Top">
                                            <TextBlock x:Name="BadgeText"
                                                       Text="ISSUE"
                                                       Foreground="#FCA5A5"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Details}"
                                               Foreground="#D8DCE5"
                                               FontSize="13"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"/>

                                    <StackPanel x:Name="FixPanel">
                                        <TextBlock Text="How to fix"
                                                   Foreground="#60A5FA"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,14,0,4"/>

                                        <TextBlock Text="{Binding Fix}"
                                                   Foreground="#D8DCE5"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock Text="Technical details"
                                               Foreground="#8F95A3"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Margin="0,14,0,4"/>

                                    <TextBlock Text="{Binding TechnicalDetails}"
                                               Foreground="#8F95A3"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Info">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#2C4A6E"/>
                                    <Setter TargetName="Badge" Property="Background" Value="#1E3A5F"/>
                                    <Setter TargetName="BadgeText" Property="Text" Value="INFO"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#93C5FD"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Passed">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#1F3D2B"/>
                                    <Setter TargetName="Card" Property="Padding" Value="14,10"/>
                                    <Setter TargetName="Badge" Property="Background" Value="#173B24"/>
                                    <Setter TargetName="BadgeText" Property="Text" Value="PASS"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#86EFAC"/>
                                    <Setter TargetName="FixPanel" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
