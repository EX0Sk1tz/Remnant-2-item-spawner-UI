<Window x:Class="Remnant2UnlockerApp.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Remnant 2 Item Spawner"
        Width="560"
        Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFont}">

    <Grid>
        <!-- Background layers (transparent in themes that don't use them) -->
        <Rectangle Fill="{DynamicResource Grain}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource SkyGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource FireGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource Vignette}" IsHitTestVisible="False"/>

        <Border Margin="18"
                Padding="24"
                Style="{DynamicResource DialogPanelStyle}">

            <StackPanel>
                <TextBlock Text="Welcome to Remnant 2 Item Spawner"
                           Style="{DynamicResource LargePageTitleStyle}"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Let's find your Remnant 2 install so the app can talk to the game. This only takes a second."
                           Foreground="{DynamicResource TextFaintBrush}"
                           FontSize="13"
                           Margin="0,8,0,20"
                           TextWrapping="Wrap"/>

                <Border Style="{DynamicResource InfoPanelStyle}"
                        Padding="14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Point this at the folder that contains the game's executable:"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"/>

                        <TextBlock Foreground="{DynamicResource TextFaintBrush}" FontSize="12">
                            <Run Text="Steam / Epic:" FontWeight="SemiBold"/>
                            <Run Text=" Remnant2\Remnant2\Binaries\Win64"/>
                        </TextBlock>

                        <TextBlock Foreground="{DynamicResource TextFaintBrush}" FontSize="12" Margin="0,4,0,0">
                            <Run Text="Game Pass:" FontWeight="SemiBold"/>
                            <Run Text=" Remnant 2\Content\Remnant2\Binaries\WinGDK"/>
                        </TextBlock>

                        <TextBlock Foreground="{DynamicResource HintTextBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Some Game Pass UE4SS builds nest mods under WinGDK\ue4ss\mods instead of WinGDK\Mods — either is fine, both are detected automatically."/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding GamePathDisplay}"
                               Foreground="{DynamicResource TextDimBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="1"
                            Content="Browse"
                            Command="{Binding SelectGamePathCommand}"
                            Style="{DynamicResource PrimaryChipButtonStyle}"/>
                </Grid>

                <Border x:Name="StatusBanner"
                        Style="{DynamicResource PathStatusBannerStyle}">
                    <TextBlock Text="{Binding GamePathStatus}"
                               Style="{DynamicResource PathStatusBannerTextStyle}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0">

                    <Button Content="Skip for now"
                            Click="Skip_Click"
                            Style="{DynamicResource ChipButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="Finish Setup"
                            Click="Finish_Click"
                            Style="{DynamicResource PrimaryChipButtonStyle}"
                            IsEnabled="{Binding IsGamePathValid}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
