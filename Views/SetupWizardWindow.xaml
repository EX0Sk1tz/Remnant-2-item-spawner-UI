<Window x:Class="Remnant2UnlockerApp.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Remnant 2 Item Spawner"
        Width="560"
        Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#101116">

    <Border Margin="18"
            Padding="24"
            Background="#1A1D27"
            BorderBrush="#33405F"
            BorderThickness="1"
            CornerRadius="16">

        <StackPanel>
            <TextBlock Text="Welcome to Remnant 2 Item Spawner"
                       Foreground="#F2F2F2"
                       FontSize="22"
                       FontWeight="Bold"
                       TextWrapping="Wrap"/>

            <TextBlock Text="Let's find your Remnant 2 install so the app can talk to the game. This only takes a second."
                       Foreground="#8F95A3"
                       FontSize="13"
                       Margin="0,8,0,20"
                       TextWrapping="Wrap"/>

            <Border Background="#252936"
                    BorderBrush="#33405F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Point this at the folder that contains the game's executable:"
                               Foreground="#D8DCE5"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"/>

                    <TextBlock Foreground="#8F95A3" FontSize="12">
                        <Run Text="Steam / Epic:" FontWeight="SemiBold"/>
                        <Run Text=" Remnant2\Remnant2\Binaries\Win64"/>
                    </TextBlock>

                    <TextBlock Foreground="#8F95A3" FontSize="12" Margin="0,4,0,0">
                        <Run Text="Game Pass:" FontWeight="SemiBold"/>
                        <Run Text=" Remnant 2\Content\Remnant2\Binaries\WinGDK"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding GamePathDisplay}"
                           Foreground="#D8DCE5"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="1"
                        Content="Browse"
                        Command="{Binding SelectGamePathCommand}"
                        Style="{StaticResource ChipButtonStyle}"
                        Background="#2563EB"
                        BorderBrush="#2563EB"
                        Foreground="#FFFFFF"/>
            </Grid>

            <Border x:Name="StatusBanner"
                    Background="#7F1D1D"
                    CornerRadius="10"
                    Padding="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#7F1D1D"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGamePathValid}" Value="True">
                                <Setter Property="Background" Value="#173B24"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding GamePathStatus}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FCA5A5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGamePathValid}" Value="True">
                                    <Setter Property="Foreground" Value="#86EFAC"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">

                <Button Content="Skip for now"
                        Click="Skip_Click"
                        Style="{StaticResource ChipButtonStyle}"
                        Margin="0,0,10,0"/>

                <Button Content="Finish Setup"
                        Click="Finish_Click"
                        Style="{StaticResource ChipButtonStyle}"
                        Background="#2563EB"
                        BorderBrush="#2563EB"
                        Foreground="#FFFFFF"
                        IsEnabled="{Binding IsGamePathValid}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
