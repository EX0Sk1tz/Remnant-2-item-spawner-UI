<Window x:Class="Remnant2UnlockerApp.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Remnant2UnlockerApp.ViewModels"
        Title="{Binding Loc[Wizard.Title]}"
        Width="780"
        Height="700"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFont}">

    <Window.Resources>
        <Style x:Key="WizardBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="WizardFaintText" TargetType="TextBlock" BasedOn="{StaticResource WizardBodyText}">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- A detected install: a selectable row with the platform and path -->
        <Style x:Key="InstallOptionStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextFaintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status mark per component state -->
        <Style x:Key="ComponentMark" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Text" Value="…"/>
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ComponentState.Ok}">
                    <Setter Property="Text" Value="✓"/>
                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ComponentState.Missing}">
                    <Setter Property="Text" Value="✕"/>
                    <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ComponentState.Automatic}">
                    <Setter Property="Text" Value="↻"/>
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ComponentState.Optional}">
                    <Setter Property="Text" Value="○"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ComponentState.Skipped}">
                    <Setter Property="Text" Value="–"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background layers (transparent in themes that don't use them) -->
        <Rectangle Fill="{DynamicResource Grain}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource SkyGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource FireGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource Vignette}" IsHitTestVisible="False"/>

        <Border Margin="18" Padding="22" Style="{DynamicResource DialogPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{Binding StepText}" Style="{StaticResource WizardFaintText}"/>
                    <TextBlock Text="{Binding Loc[Wizard.Title]}" Style="{DynamicResource LargePageTitleStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>

                        <!-- ============ 1. Game folder ============ -->
                        <StackPanel Visibility="{Binding IsGamePage, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Loc[Wizard.GameIntro]}" Style="{StaticResource WizardBodyText}" Margin="0,0,0,14"/>

                            <ContentControl Content="{Binding Loc[Wizard.DetectedInstalls]}" Style="{DynamicResource SectionHeaderStyle}"/>

                            <TextBlock Text="{Binding Loc[Wizard.Searching]}" Style="{StaticResource WizardFaintText}" Margin="0,0,0,10"
                                       Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding Loc[Wizard.NoneFound]}" Style="{StaticResource WizardFaintText}" Margin="0,0,0,10"
                                       Visibility="{Binding NoInstallsFound, Converter={StaticResource BoolVis}}"/>

                            <ItemsControl ItemsSource="{Binding DetectedInstalls}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="DetectedInstall"
                                                     Style="{StaticResource InstallOptionStyle}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding Win64Path}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding PlatformName}" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding Win64Path}" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ContentControl Content="{Binding Loc[Wizard.GameFolder]}" Style="{DynamicResource SectionHeaderStyle}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         x:Name="GamePathBox"
                                         Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource SettingsTextBoxStyle}"
                                         TextAlignment="Left"
                                         Padding="8,0"
                                         Margin="0,0,10,0"
                                         AutomationProperties.Name="Game folder"/>

                                <Button Grid.Column="1"
                                        Content="{Binding Loc[Main.Browse]}"
                                        Command="{Binding BrowseCommand}"
                                        Style="{DynamicResource ChipButtonStyle}"/>
                            </Grid>

                            <Border Style="{DynamicResource InfoPanelStyle}" Padding="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" Foreground="{DynamicResource GoodBrush}" FontWeight="Bold" Margin="0,0,8,0"
                                               Visibility="{Binding IsGamePathValid, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="✕" Foreground="{DynamicResource BadBrush}" FontWeight="Bold" Margin="0,0,8,0"
                                               Visibility="{Binding IsGamePathValid, Converter={StaticResource BoolVisInv}}"/>
                                    <TextBlock Text="{Binding GamePathStatusText}" Style="{StaticResource WizardBodyText}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding Loc[Wizard.GameHint]}" Style="{StaticResource WizardFaintText}" Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- ============ 2a. Game must be closed ============ -->
                        <StackPanel Visibility="{Binding IsCloseGamePage, Converter={StaticResource BoolVis}}">
                            <Border Style="{DynamicResource InfoPanelStyle}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[Wizard.CloseGameTitle]}" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Loc[Wizard.CloseGameText]}" Style="{StaticResource WizardBodyText}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Loc[Wizard.WaitingForGameClose]}" Style="{StaticResource WizardFaintText}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ 2. Components ============ -->
                        <StackPanel Visibility="{Binding IsComponentsPage, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Loc[Wizard.ComponentsIntro]}" Style="{StaticResource WizardBodyText}" Margin="0,0,0,14"/>

                            <ItemsControl ItemsSource="{Binding Components}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource SectionCardStyle}" Margin="0,0,0,10" Padding="14,12">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Style="{StaticResource ComponentMark}"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ComponentState.Ok}">
                                                                            <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ComponentState.Missing}">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:ComponentState.Waiting}">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource WizardFaintText}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Nexus download: open page, then drop the file or choose it -->
                                                <Grid Margin="26,10,0,0"
                                                      AllowDrop="True"
                                                      DragOver="PackageDrop_DragOver"
                                                      Drop="PackageDrop_Drop"
                                                      Visibility="{Binding AcceptsPackage, Converter={StaticResource BoolVis}}">
                                                    <Rectangle Stroke="{DynamicResource HairlineBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"
                                                               RadiusX="8" RadiusY="8" Fill="Transparent"/>
                                                    <StackPanel Margin="12,10">
                                                        <TextBlock Text="{Binding DataContext.Loc[Wizard.DropHere], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   Style="{StaticResource WizardFaintText}" Margin="0,0,0,8"/>
                                                        <WrapPanel>
                                                            <Button Content="{Binding DataContext.Loc[Wizard.OpenNexus], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Click="OpenNexus_Click" Style="{DynamicResource ChipButtonStyle}" Margin="0,0,8,4"/>
                                                            <Button Content="{Binding DataContext.Loc[Wizard.ChooseFile], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Click="ChooseFile_Click" Style="{DynamicResource PrimaryChipButtonStyle}" Margin="0,0,8,4"/>
                                                            <Button Content="{Binding DataContext.Loc[Wizard.ChooseFolder], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Click="ChooseFolder_Click" Style="{DynamicResource ChipButtonStyle}" Margin="0,0,8,4"/>
                                                            <Button Content="{Binding DataContext.Loc[Wizard.Skip], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Click="SkipTraits_Click" Style="{DynamicResource ChipButtonStyle}" Margin="0,0,8,4"
                                                                    Visibility="{Binding CanSkip, Converter={StaticResource BoolVis}}"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding Loc[Wizard.InstallRepair]}"
                                        Command="{Binding InstallRepairCommand}"
                                        Style="{DynamicResource PrimaryDialogButtonStyle}"
                                        Padding="18,0"/>

                                <TextBlock Grid.Column="1" Text="{Binding Loc[Wizard.InstallRepairHint]}" Style="{StaticResource WizardFaintText}"
                                           VerticalAlignment="Center" Margin="12,0"/>

                                <Button Grid.Column="2"
                                        Content="{Binding Loc[Wizard.RestoreBackup]}"
                                        Command="{Binding RestoreBackupCommand}"
                                        Style="{DynamicResource ChipButtonStyle}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <Border Margin="0,12,0,0" Padding="12"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}"/>
                                        <Setter Property="CornerRadius" Value="10"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Content="{Binding Loc[Wizard.RestartAsAdmin]}"
                                            Command="{Binding RestartAsAdminCommand}"
                                            Style="{DynamicResource PrimaryChipButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding ShowAdminRestart, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ 3. Antivirus check ============ -->
                        <StackPanel Visibility="{Binding IsAntivirusPage, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Loc[Wizard.AntivirusIntro]}" Style="{StaticResource WizardBodyText}" Margin="0,0,0,14"/>

                            <Border Style="{DynamicResource InfoPanelStyle}" Padding="16"
                                    Visibility="{Binding IsAntivirusChecking, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Loc[Wizard.AntivirusChecking]}" Style="{StaticResource WizardBodyText}"/>
                            </Border>

                            <Border Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="10" Padding="16"
                                    Visibility="{Binding IsAntivirusOk, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Loc[Wizard.AntivirusOk]}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                            </Border>

                            <Border Style="{DynamicResource ErrorPanelStyle}" Padding="16"
                                    Visibility="{Binding IsAntivirusRemoved, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[Wizard.AntivirusRemovedTitle]}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding AntivirusMissingText}" Foreground="{DynamicResource CodeTextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Loc[Wizard.AntivirusRemovedText]}" Style="{StaticResource WizardBodyText}" Margin="0,10,0,0"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="{Binding Loc[Wizard.OpenWindowsSecurity]}" Command="{Binding OpenWindowsSecurityCommand}" Style="{DynamicResource ChipButtonStyle}" Margin="0,0,8,0"/>
                                        <Button Content="{Binding Loc[Wizard.CheckAgain]}" Command="{Binding RecheckAntivirusCommand}" Style="{DynamicResource PrimaryChipButtonStyle}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ 4. Test launch ============ -->
                        <StackPanel Visibility="{Binding IsTestLaunchPage, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Loc[Wizard.TestIntro]}" Style="{StaticResource WizardBodyText}" Margin="0,0,0,14"/>

                            <Button Content="{Binding Loc[Wizard.StartGameSteam]}"
                                    Command="{Binding LaunchGameCommand}"
                                    Style="{DynamicResource PrimaryDialogButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="18,0"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding CanLaunchViaSteam, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding Loc[Wizard.StartGameManual]}" Style="{StaticResource WizardBodyText}" FontWeight="SemiBold" Margin="0,0,0,14"
                                       Visibility="{Binding CanLaunchViaSteam, Converter={StaticResource BoolVisInv}}"/>

                            <Border Style="{DynamicResource InfoPanelStyle}" Padding="16"
                                    Visibility="{Binding IsTestWaiting, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Loc[Wizard.TestWaiting]}" Style="{StaticResource WizardBodyText}"/>
                            </Border>

                            <Border Style="{DynamicResource InfoPanelStyle}" Padding="16"
                                    Visibility="{Binding IsTestModLoaded, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Loc[Wizard.TestModLoaded]}" Style="{StaticResource WizardBodyText}"/>
                            </Border>

                            <Border Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="10" Padding="16"
                                    Visibility="{Binding IsTestConnected, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Loc[Wizard.TestConnected]}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                            </Border>

                            <Border Style="{DynamicResource ErrorPanelStyle}" Padding="16"
                                    Visibility="{Binding IsTestTimedOut, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Loc[Wizard.TestTimedOut]}" Style="{StaticResource WizardBodyText}"/>
                            </Border>
                        </StackPanel>

                        <!-- ============ 5. Done ============ -->
                        <StackPanel Visibility="{Binding IsDonePage, Converter={StaticResource BoolVis}}">
                            <Border Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[Wizard.DoneTitle]}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Loc[Wizard.DoneText]}" Style="{StaticResource WizardBodyText}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{Binding Loc[Wizard.Close]}"
                            Click="Close_Click"
                            Style="{DynamicResource ChipButtonStyle}"/>

                    <Button Grid.Column="2"
                            Content="{Binding Loc[Wizard.Back]}"
                            Command="{Binding BackCommand}"
                            Style="{DynamicResource ChipButtonStyle}"
                            Margin="0,0,10,0"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolVis}}"/>

                    <Button Grid.Column="3"
                            Content="{Binding NextText}"
                            Command="{Binding NextCommand}"
                            Style="{DynamicResource PrimaryChipButtonStyle}"
                            MinWidth="110"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
