<Window x:Class="Remnant2UnlockerApp.Views.SpawnProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spawn Progress"
        Width="540"
        SizeToContent="Height"
        MinHeight="230"
        MaxHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource UiFont}">

    <Grid>
        <!-- Background layers (transparent in themes that don't use them) -->
        <Rectangle Fill="{DynamicResource Grain}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource SkyGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource FireGlow}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource Vignette}" IsHitTestVisible="False"/>

        <Border Margin="18"
                Padding="18"
                Style="{DynamicResource DialogPanelStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Title, Mode=OneWay}"
                           Style="{DynamicResource PageTitleStyle}"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding Message, Mode=OneWay}"
                           Foreground="{DynamicResource StatusTextBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0"
                                 Style="{DynamicResource SpawnProgressBarStyle}"
                                 Height="16"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressText, Mode=OneWay}"
                               Foreground="{DynamicResource AccentTextBrush}"
                               FontSize="13"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Grid.Row="3"
                           Text="{Binding EstimatedTimeText, Mode=OneWay}"
                           Foreground="{DynamicResource TextFaintBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Border Grid.Row="4"
                        Style="{DynamicResource ErrorPanelStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"
                        MinHeight="58"
                        Margin="0,4,0,0">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="82">
                        <TextBlock Text="{Binding ErrorText, Mode=OneWay}"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">

                    <Button Content="Cancel Spawn"
                            Style="{DynamicResource DangerDialogButtonStyle}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                            Click="Cancel_Click"/>

                    <Button Content="Close"
                            Style="{DynamicResource DialogButtonStyle}"
                            Padding="16,0"
                            Margin="10,0,0,0"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
